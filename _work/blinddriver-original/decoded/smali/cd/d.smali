    sput-object v0, Lcd/d;->q:Lcd/c;

    new-instance v0, Lcd/c;

    const-string v1, "Bluetooth-\u0430\u0434\u0430\u043f\u0442\u0435\u0440 ELM327 \u0443 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u043e\u043c\u0443 \u0440\u043e\u0437\'\u0454\u043c\u0456 \u0430\u0432\u0442\u043e \u0434\u0430\u0454 \u0442\u043e\u0447\u043d\u0443 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0456 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u0438\u0439 \u0448\u043b\u044f\u0445 \u2014 \u043c\u0430\u0440\u043a\u0435\u0440 \u043d\u0435 \u00ab\u0442\u0456\u043a\u0430\u0454\u00bb \u0456 \u043d\u0435 \u0432\u0456\u0434\u0441\u0442\u0430\u0454 \u0431\u0435\u0437 GPS. \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0437\'\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u0456\u0437 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u043c \u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 Bluetooth (PIN \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 1234 \u0430\u0431\u043e 0000)."

    const-string v2, "A Bluetooth ELM327 adapter in the car\'s diagnostic port gives exact speed and distance, so the marker does not run ahead or lag without GPS. First pair the adapter with the phone in Bluetooth settings (PIN is usually 1234 or 0000)."

    invoke-direct {v0, v1, v2}, Lcd/c;-><init>(Ljava/lang/String;Ljava/lang/String;)V

