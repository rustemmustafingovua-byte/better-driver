    new-instance v0, Lcd/c;

    const-string v1, "\u0417\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u00ab\u044f\u043a \u0454\u00bb, \u0431\u0435\u0437 \u0436\u043e\u0434\u043d\u0438\u0445 \u0433\u0430\u0440\u0430\u043d\u0442\u0456\u0439. \u0410\u0432\u0442\u043e\u0440 \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0437\u0430 \u0437\u0431\u0438\u0442\u043a\u0438, \u0448\u0442\u0440\u0430\u0444\u0438 \u0447\u0438 \u0448\u043a\u043e\u0434\u0443, \u0449\u043e \u0432\u0438\u043d\u0438\u043a\u043b\u0438 \u0432\u043d\u0430\u0441\u043b\u0456\u0434\u043e\u043a \u0439\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f.\n\n\u041c\u0430\u0440\u0448\u0440\u0443\u0442\u0438 \u043f\u0440\u043e\u043a\u043b\u0430\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456\u043c\u0438 \u0441\u0435\u0440\u0432\u0456\u0441\u0430\u043c\u0438 (Mapbox, OSRM, \u0434\u0430\u043d\u0456 OpenStreetMap) \u0430\u0431\u043e \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456. \u0410\u0432\u0442\u043e\u0440 \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0437\u0430 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u043a\u043b\u0430\u0434\u0435\u043d\u0438\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0442\u0430\u043a\u0438\u0439, \u0449\u043e \u0441\u0443\u043f\u0435\u0440\u0435\u0447\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c \u0434\u043e\u0440\u043e\u0436\u043d\u044c\u043e\u0433\u043e \u0440\u0443\u0445\u0443, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0437\u0430 \u043d\u0435\u0442\u043e\u0447\u043d\u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u044e, \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c, \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f, \u043a\u0430\u043c\u0435\u0440\u0438, \u0441\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0438 \u0447\u0438 \u0442\u0440\u0438\u0432\u043e\u0433\u0438.\n\n\u0417\u0430\u0432\u0436\u0434\u0438 \u0437\u0432\u0456\u0440\u044f\u0439\u0442\u0435\u0441\u044f \u0437 \u0434\u043e\u0440\u043e\u0436\u043d\u0456\u043c\u0438 \u0437\u043d\u0430\u043a\u0430\u043c\u0438, \u0440\u043e\u0437\u043c\u0456\u0442\u043a\u043e\u044e, \u0441\u0438\u0433\u043d\u0430\u043b\u0430\u043c\u0438 \u0441\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0456\u0432 \u0456 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u044e \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u043e\u044e: \u0432\u043e\u043d\u0438 \u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u0456 \u0437\u0430 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443."

    const-string v2, "The app is provided \u201cas is\u201d, without any warranty. The author is not liable for any loss, fines or damage arising from its use.\n\nRoutes are built by third-party services (Mapbox, OSRM, OpenStreetMap data) or calculated on the phone. The author is not responsible for an incorrectly built route, including one that violates traffic rules, or for inaccurate position, speed, limits, cameras, traffic lights or alerts.\n\nAlways check road signs, markings, traffic lights and the real situation: they take precedence over the app\'s prompts."

