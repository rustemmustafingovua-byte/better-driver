    const-string v1, "\u041f\u043e\u043a\u0430\u0436\u0435\u043c\u043e \u043a\u043d\u043e\u043f\u043a\u0438 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 \u0439 \u00ab\u043f\u043e\u0457\u0437\u0434\u043a\u0443\u00bb, \u0434\u0435 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0432\u0435\u0434\u0435 \u0431\u0435\u0437 GPS. \u0426\u0435 \u0437\u0430\u0439\u043c\u0430\u0454 \u043f\u0430\u0440\u0443 \u0445\u0432\u0438\u043b\u0438\u043d. \u041f\u0456\u0437\u043d\u0456\u0448\u0435 \u0442\u0443\u0440 \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0432 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445."

