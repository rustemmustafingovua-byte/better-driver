    sput-object v0, Lnd/a;->r:Lcd/c;

    new-instance v0, Lcd/c;

    const-string v1, "\u041d\u0430\u0432\u0456\u0433\u0430\u0442\u043e\u0440, \u0449\u043e \u0432\u0435\u0434\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u043c \u043d\u0430\u0432\u0456\u0442\u044c \u0442\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 GPS \u0433\u043b\u0443\u0448\u0430\u0442\u044c \u0430\u0431\u043e \u0432\u0456\u043d \u0431\u0440\u0435\u0448\u0435. \u041f\u0435\u0440\u0435\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u043c \u043a\u043e\u0440\u043e\u0442\u043a\u043e \u043f\u0440\u043e \u0442\u0435, \u0449\u043e \u0439\u043e\u043c\u0443 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e."

    const-string v2, "A navigator that guides you by voice even when GPS is jammed or lies. Before you start, here is what it needs and why."

    invoke-direct {v0, v1, v2}, Lcd/c;-><init>(Ljava/lang/String;Ljava/lang/String;)V

