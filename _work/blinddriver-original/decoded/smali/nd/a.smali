    new-instance v0, Lcd/c;

    const-string v1, "\u0429\u043e\u0431 \u043f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448\u0435 \u043c\u0456\u0441\u0446\u0435 \u043d\u0430 \u043a\u0430\u0440\u0442\u0456 \u0439 \u0432\u0435\u0441\u0442\u0438 \u0437\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c. \u0417\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0457\u0457, \u043f\u043e\u043a\u0438 \u0432\u0456\u043d \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u0439 \u0430\u0431\u043e \u0442\u0440\u0438\u0432\u0430\u0454 \u0432\u0435\u0434\u0435\u043d\u043d\u044f (\u0435\u043a\u0440\u0430\u043d \u043f\u0440\u0438 \u0446\u044c\u043e\u043c\u0443 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043c\u043a\u043d\u0443\u0442\u0438)."

    const-string v2, "To show your position on the map and guide you along the route. The app uses it while it is open or while guidance is running (the screen can be off)."

