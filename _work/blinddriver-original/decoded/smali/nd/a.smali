    sput-object v0, Lnd/a;->x:Lcd/c;

    new-instance v0, Lcd/c;

    const-string v1, "\u041d\u0430 \u0434\u0435\u044f\u043a\u0438\u0445 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430\u0445 (Xiaomi, Samsung, Huawei \u0442\u0430 \u0456\u043d\u0448\u0438\u0445) \u0442\u0440\u0435\u0431\u0430 \u0437\u043d\u044f\u0442\u0438 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0434\u043b\u044f BlindDriver, \u0456\u043d\u0430\u043a\u0448\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043c\u043e\u0436\u0435 \u043f\u0440\u0438\u0441\u0438\u043f\u043b\u044f\u0442\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a. \u041f\u0456\u0434\u043a\u0430\u0437\u043a\u0430 \u0431\u0443\u0434\u0435 \u0432 \u0442\u0443\u0440\u0456."

    const-string v2, "On some phones (Xiaomi, Samsung, Huawei and others) battery restrictions for BlindDriver must be lifted, otherwise the system may put the app to sleep. The tour has a tip about it."

    invoke-direct {v0, v1, v2}, Lcd/c;-><init>(Ljava/lang/String;Ljava/lang/String;)V

    sput-object v0, Lnd/a;->y:Lcd/c;

    new-instance v0, Lcd/c;

    const-string v1, "\u0414\u043e\u0437\u0432\u043e\u043b\u0438 \u043c\u043e\u0436\u043d\u0430 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430. \u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456 \u2014 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u041f\u0440\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a."

