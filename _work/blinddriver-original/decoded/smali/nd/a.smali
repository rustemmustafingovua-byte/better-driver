    sput-object v0, Lnd/a;->v:Lcd/c;

    new-instance v0, Lcd/c;

    const-string v1, "\u041f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0442\u0435, \u0449\u043e \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u0435. \u0411\u0435\u0437 \u043d\u044c\u043e\u0433\u043e \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0437\u0443\u043f\u0438\u043d\u0438\u0442\u0438 \u0432\u0435\u0434\u0435\u043d\u043d\u044f, \u043a\u043e\u043b\u0438 \u0435\u043a\u0440\u0430\u043d \u0437\u0433\u0430\u0441\u043d\u0435."

    const-string v2, "While guidance runs the system shows a notification that guidance is active. Without it the system may stop guidance when the screen turns off."

