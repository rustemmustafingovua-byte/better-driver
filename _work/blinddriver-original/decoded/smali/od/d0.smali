    invoke-direct {v5, v7}, Lod/g0;-><init>(Ljava/lang/String;)V

    const-string v7, "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f (\u0448\u0435\u0441\u0442\u0435\u0440\u043d\u044f)"

    const-string v9, "\u0414\u043e\u0432\u0456\u0434\u043a\u0430, \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043b\u043e\u0433\u0443 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0443, \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0430, \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430 \u043f\u043e\u0457\u0437\u0434\u043e\u043a, \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u043a\u043b\u044e\u0447 Mapbox, \u043f\u043e\u0440\u043e\u0433\u0438 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0439 \u0434\u0430\u0442\u0447\u0438\u043a\u0456\u0432, \u043a\u0430\u043c\u0435\u0440\u0438, \u043a\u0430\u0440\u0442\u0430, \u043e\u0444\u043b\u0430\u0439\u043d-\u043a\u0430\u0440\u0442\u0430, \u043e\u0444\u043b\u0430\u0439\u043d-\u043f\u043e\u0448\u0443\u043a \u0456 \u043e\u0444\u043b\u0430\u0439\u043d-\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438, \u043b\u043e\u0433\u0438 \u0439 \u00ab\u041f\u0440\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a\u00bb."

