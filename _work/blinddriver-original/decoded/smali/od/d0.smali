    const-string v15, "\u21bb 8 \u0441"

    invoke-direct {v14, v15}, Lod/g0;-><init>(Ljava/lang/String;)V

    const-string v15, "\u00ab\u0421\u0445\u043e\u0436\u0435, \u0432\u0438 \u0437\'\u0457\u0445\u0430\u043b\u0438 \u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443\u00bb"

    move-object/from16 v33, v1

    const-string v1, "\u0411\u0435\u0437 \u043d\u0430\u0434\u0456\u0439\u043d\u043e\u0433\u043e GPS \u0441\u0445\u0456\u0434 \u043f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u0433\u0456\u0440\u043e\u0441\u043a\u043e\u043f (\u043f\u043e\u0432\u043e\u0440\u043e\u0442, \u0449\u043e \u043d\u0435 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u0436\u043e\u0434\u043d\u0438\u043c \u043c\u0430\u043d\u0435\u0432\u0440\u043e\u043c \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u0440\u043e\u0437\u0432\u043e\u0440\u043e\u0442), \u043c\u0435\u0440\u0435\u0436\u0430 (\u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0434\u0430\u043b\u0435\u043a\u043e \u0432\u0456\u0434 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443) \u0430\u0431\u043e \u0441\u0443\u043c\u043d\u0456\u0432\u043d\u0438\u0439 GPS: \u043f\u043e\u043c\u0430\u0440\u0430\u043d\u0447\u0435\u0432\u0430 \u043f\u043b\u0430\u0448\u043a\u0430 \u0437 \u0432\u0456\u0434\u043b\u0456\u043a\u043e\u043c \u0441\u0435\u043a\u0443\u043d\u0434. \u00ab\u041f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0440\u0430\u0437\u00bb \u2014 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0454 \u043e\u0434\u0440\u0430\u0437\u0443; \u00ab\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438\u00bb \u2014 \u043b\u0438\u0448\u0438\u0442\u044c \u0441\u0442\u0430\u0440\u0438\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0456 \u043d\u0435 \u0437\u0430\u043f\u0438\u0442\u0430\u0454 \u0437\u043d\u043e\u0432\u0443 \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u0456 \u043f\u0456\u0432\u0442\u043e\u0440\u0438 \u0445\u0432\u0438\u043b\u0438\u043d\u0438. \u042f\u043a\u0449\u043e \u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 \u043d\u0456\u0447\u043e\u0433\u043e, \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0454 \u0441\u0430\u043c\u0430 \u2014 \u0430\u0431\u043e, \u044f\u043a\u0449\u043e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u00ab\u0410\u0432\u0442\u043e-\u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430 \u0431\u0435\u0437 GPS\u00bb, \u043f\u043e\u0447\u0435\u043a\u0430\u0454 \u0432\u0430\u0448\u043e\u0457 \u043a\u043d\u043e\u043f\u043a\u0438 \u0445\u0432\u0438\u043b\u0438\u043d\u0443. \u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u0438\u043c\u0438\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0435\u043c \u00ab\u0412\u0438\u044f\u0432\u043b\u044f\u0442\u0438 \u0441\u0445\u0456\u0434 \u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u0431\u0435\u0437 GPS\u00bb."

    invoke-direct {v0, v14, v15, v1}, Lod/j0;-><init>(Lod/i0;Ljava/lang/String;Ljava/lang/String;)V

