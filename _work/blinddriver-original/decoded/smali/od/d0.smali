    const-string v9, "\u041b\u0438\u0448\u0435 \u0423\u043a\u0440\u0430\u0457\u043d\u0430"

    const-string v10, "\u0423 \u0446\u0456\u0439 \u0432\u0435\u0440\u0441\u0456\u0457 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0442\u0456\u043b\u044c\u043a\u0438 \u0423\u043a\u0440\u0430\u0457\u043d\u0430: \u0442\u043e\u0447\u043a\u0438 \u0437\u0430 \u0457\u0457 \u043c\u0435\u0436\u0430\u043c\u0438 (A, B, \u00ab\u0447\u0435\u0440\u0435\u0437\u00bb) \u043d\u0435 \u043f\u0440\u0438\u0439\u043c\u0430\u044e\u0442\u044c\u0441\u044f, \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u043f\u043e\u0448\u0443\u043a\u0443 \u0442\u0435\u0436 \u043f\u043e\u043a\u0430\u0437\u0443\u044e\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0456, \u043c\u0430\u0440\u0448\u0440\u0443\u0442, \u0449\u043e \u0432\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u0437\u0430 \u043c\u0435\u0436\u0456 \u043a\u0440\u0430\u0457\u043d\u0438, \u043d\u0435 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f."

