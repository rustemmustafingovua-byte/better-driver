    const-string v9, "\u041a\u043d\u043e\u043f\u043a\u0430 \u00ab\u041e\u0444\u043e\u0440\u043c\u0438\u0442\u0438 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0443\u00bb (\u00ab\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0443\u00bb) \u043f\u0440\u0430\u0446\u044e\u0454 \u0431\u0435\u0437 Telegram: \u043e\u0431\u0435\u0440\u0456\u0442\u044c \u0442\u0435\u0440\u043c\u0456\u043d (1, 3, 6 \u043c\u0456\u0441\u044f\u0446\u0456\u0432 \u0430\u0431\u043e \u0440\u0456\u043a) \u0456 \u0437\u0430 \u0431\u0430\u0436\u0430\u043d\u043d\u044f\u043c \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0435\u043d\u043d\u044f, \u0434\u0430\u043b\u0456 \u00ab\u0421\u043f\u043b\u0430\u0442\u0438\u0442\u0438\u00bb \u0432\u0456\u0434\u043a\u0440\u0438\u0454 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u043e\u043f\u043b\u0430\u0442\u0438 \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0456, \u0430 \u00abQR-\u043a\u043e\u0434\u00bb \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0441\u043f\u043b\u0430\u0442\u0438\u0442\u0438 \u0437 \u0456\u043d\u0448\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e. \u041f\u0456\u0434\u043f\u0438\u0441\u043a\u0430 \u043f\u0440\u0438\u0432\'\u044f\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443; \u043d\u0430 \u0456\u043d\u0448\u0438\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0457\u0457 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u044c \u043a\u043e\u0434: \u00ab\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u043a\u043e\u0434 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0443\u00bb \u043d\u0430 \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456, \u00ab\u0412\u0432\u0435\u0441\u0442\u0438 \u043a\u043e\u0434 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0443\u00bb \u043d\u0430 \u043d\u043e\u0432\u043e\u043c\u0443 (\u043a\u043e\u0434 \u0434\u0456\u0454 15 \u0445\u0432\u0438\u043b\u0438\u043d, \u0441\u043f\u0440\u0430\u0446\u044c\u043e\u0432\u0443\u0454 \u0440\u0430\u0437, \u0441\u0442\u0430\u0440\u0438\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0443 \u0432\u0442\u0440\u0430\u0447\u0430\u0454). \u00ab\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0435\u043d\u043d\u044f\u00bb \u0432\u0438\u043c\u0438\u043a\u0430\u0454 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456 \u0441\u043f\u0438\u0441\u0430\u043d\u043d\u044f. \u0414\u043b\u044f \u0442\u0438\u0445, \u0445\u0442\u043e \u043c\u0430\u0454 Telegram, \u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u00ab\u041e\u0444\u043e\u0440\u043c\u0438\u0442\u0438 \u0432 Telegram\u00bb, \u00ab\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0443\u00bb \u0439 \u00ab\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430 \u0432 Telegram\u00bb (\u0431\u043e\u0442 @Blind_Driver_bot); \u0443\u0441\u0435 \u0437\'\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0442\u0430\u0440\u0438\u0444\u0438 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e."

    invoke-static {v9}, Lcd/f;->b(Ljava/lang/String;)Ljava/lang/String;

