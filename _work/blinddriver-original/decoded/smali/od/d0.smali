    const-string v10, "\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043b\u043e\u0433 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0443"

    const-string v11, "\u041e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u043b\u043e\u0433, \u043e\u0431\u0440\u0430\u043d\u0456 \u0430\u0431\u043e \u0437\u0430 \u0434\u0435\u043d\u044c, \u0437 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0435\u043c \u0456 \u0434\u0430\u043d\u0438\u043c\u0438 \u043f\u0440\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d. \u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f\u043c \u0456 \u043f\u0440\u0438 \u00ab\u041f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f\u00bb \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0431\u0456\u043b\u044f \u0441\u0442\u0430\u0440\u0442\u0443 \u0439 \u0444\u0456\u043d\u0456\u0448\u0443 \u0432\u0438\u0440\u0456\u0437\u0430\u044e\u0442\u044c\u0441\u044f (\u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c 300 \u043c; \u0432\u0438\u043c\u0438\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u041b\u043e\u0433\u0438). \u00ab\u041e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u043b\u043e\u0433\u00bb \u2014 \u043e\u0441\u0442\u0430\u043d\u043d\u044f \u043f\u043e\u0457\u0437\u0434\u043a\u0430 \u0434\u043e\u0432\u0448\u0430 \u0437\u0430 \u0445\u0432\u0438\u043b\u0438\u043d\u0443; \u0456\u043d\u0448\u0438\u0439 \u0444\u0430\u0439\u043b \u2014 \u00ab\u041e\u0431\u0440\u0430\u043d\u0456\u00bb. \u0412\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f\u043c \u0456 \u0432\u0456\u043a\u043d\u043e\u043c \u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443, \u0442\u0430\u043c \u0436\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0441\u0442\u0438 (\u0440\u043e\u0437\u0434\u0456\u043b \u00ab\u041b\u0438\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u043e\u043c\u00bb)."

