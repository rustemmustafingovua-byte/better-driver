    const-string v9, "\u0412\u0430\u043d\u0442\u0430\u0436\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c"

    const-string v10, "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u00ab\u0422\u0438\u043f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f\u00bb \u2192 \u00ab\u0412\u0430\u043d\u0442\u0430\u0436\u043d\u0438\u0439\u00bb. \u0412\u043a\u0430\u0436\u0456\u0442\u044c \u043f\u043e\u0432\u043d\u0443 \u043c\u0430\u0441\u0443 (\u0437 \u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043c), \u0432\u0438\u0441\u043e\u0442\u0443 \u0439 \u0448\u0438\u0440\u0438\u043d\u0443: \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u043e\u043c\u0438\u043d\u0430\u0442\u0438\u043c\u0435 \u043c\u043e\u0441\u0442\u0438, \u0434\u043e\u0440\u043e\u0433\u0438 \u0439 \u043f\u0440\u043e\u0457\u0437\u0434\u0438, \u0434\u0435 \u0437\u043d\u0430\u043a\u0438 OpenStreetMap \u0437\u0430\u0431\u043e\u0440\u043e\u043d\u044f\u044e\u0442\u044c \u0432\u0430\u0448\u0443 \u043c\u0430\u0441\u0443, \u0432\u0438\u0441\u043e\u0442\u0443, \u0448\u0438\u0440\u0438\u043d\u0443 \u0430\u0431\u043e \u0432\u0430\u043d\u0442\u0430\u0436\u043d\u0438\u0439 \u0440\u0443\u0445. \u041f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u043e\u043a\u0440\u0435\u043c\u0438\u0439 \u0433\u0440\u0430\u0444 \u00ab\u0423\u043a\u0440\u0430\u0457\u043d\u0430 \u0434\u043b\u044f \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043e\u043a\u00bb (\u041a\u0430\u0440\u0442\u0430 \u0439 \u043e\u0444\u043b\u0430\u0439\u043d \u2192 \u0413\u0440\u0430\u0444 \u0434\u043e\u0440\u0456\u0433 \u0434\u043b\u044f \u0432\u0430\u043d\u0442\u0430\u0436\u0456\u0432\u043e\u043a, \u0431\u043b\u0438\u0437\u044c\u043a\u043e 285 \u041c\u0411, \u043f\u0456\u0441\u043b\u044f \u0440\u043e\u0437\u043f\u0430\u043a\u0443\u0432\u0430\u043d\u043d\u044f 500 \u041c\u0411; \u043a\u0440\u0430\u0449\u0435 \u043f\u043e Wi-Fi). \u0423 \u0432\u0430\u043d\u0442\u0430\u0436\u043d\u043e\u043c\u0443 \u0440\u0435\u0436\u0438\u043c\u0456 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438 \u0431\u0443\u0434\u0443\u044e\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u0437\u0430 \u043d\u0438\u043c, \u043d\u0430\u0432\u0456\u0442\u044c \u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c: Mapbox \u0456 OSRM \u0446\u0438\u0445 \u0437\u043d\u0430\u043a\u0456\u0432 \u043d\u0435 \u0437\u043d\u0430\u044e\u0442\u044c, \u0437\u0430\u0442\u043e\u0440\u0438 \u043d\u0435 \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f. \u0424\u0443\u043d\u043a\u0446\u0456\u044f \u043f\u043b\u0430\u0442\u043d\u0430 (\u043f\u0440\u043e\u0431\u043d\u0438\u0439 \u043f\u0435\u0440\u0456\u043e\u0434 \u0430\u0431\u043e \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0430). \u0417\u043d\u0430\u043a\u0438 \u0432 OpenStreetMap \u0454 \u043d\u0435 \u0441\u043a\u0440\u0456\u0437\u044c, \u0442\u043e\u043c\u0443 \u0437\u043d\u0430\u043a\u0438 \u043d\u0430 \u0434\u043e\u0440\u043e\u0437\u0456 \u0437\u0430\u0432\u0436\u0434\u0438 \u0433\u043e\u043b\u043e\u0432\u043d\u0456\u0448\u0456 \u0437\u0430 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443."

