    const-string v5, "\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u0420\u0443\u0448\u0430\u0439\u00bb. \u0417\u043d\u0438\u0437\u0443 \u0437\'\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0438 \u0437 \u0447\u0430\u0441\u043e\u043c, \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u043d\u044e \u0456 \u0437\u0430\u0442\u043e\u0440\u043e\u043c; \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0430 \u0432\u0430\u0440\u0456\u0430\u043d\u0442, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u043d\u0430 \u043a\u0430\u0440\u0442\u0456."

