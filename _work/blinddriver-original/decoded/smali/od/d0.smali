    const-string v1, "\u041e\u0434\u043d\u0438\u043c \u0440\u044f\u0434\u043a\u043e\u043c \u043f\u0456\u0434 \u0447\u0430\u0441\u043e\u043c \u043f\u0440\u0438\u0431\u0443\u0442\u0442\u044f. \u00abGPS\u00bb: \u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0437\u0430 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0430\u043c\u0438. \u00abGPS?\u00bb: \u0441\u043b\u0430\u0431\u043a\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b. \u00ab\u2192\u00bb: \u0431\u0435\u0437 GPS \u043c\u0430\u0440\u043a\u0435\u0440 \u0432\u0435\u0434\u0435 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043e\u043a \u043f\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430\u0445, \u043c\u0435\u0440\u0435\u0436\u0456 \u0439 \u043a\u0430\u0440\u0442\u0456 \u0434\u043e\u0440\u0456\u0433. \u00ab\u270b\u00bb: \u0432\u0438 \u0449\u043e\u0439\u043d\u043e \u0437\u0441\u0443\u043d\u0443\u043b\u0438 \u043c\u0430\u0440\u043a\u0435\u0440 \u0432\u0440\u0443\u0447\u043d\u0443. \u00ab\u23f8\u00bb: \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u043f\u043e\u043a\u0430\u0437\u0443\u044e\u0442\u044c \u0437\u0443\u043f\u0438\u043d\u043a\u0443. \u0414\u0430\u043b\u0456 \u00ab\u00b130\u043c\u00bb \u2014 \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u043f\u043e\u0437\u0438\u0446\u0456\u044f \u043c\u043e\u0436\u0435 \u043f\u043e\u043c\u0438\u043b\u044f\u0442\u0438\u0441\u044f, \u0456 \u00abGPS \u22123:02\u00bb \u2014 \u044f\u043a \u0434\u0430\u0432\u043d\u043e \u0431\u0443\u0432 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 GPS. \u00ab\u21bb\u2026\u00bb: \u0442\u0440\u0438\u0432\u0430\u0454 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430."

