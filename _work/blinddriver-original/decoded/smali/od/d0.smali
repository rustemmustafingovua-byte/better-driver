    const-string v11, "\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043c\u043e\u0457 \u0434\u0430\u043d\u0456"

    const-string v12, "\u041f\u0440\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u2192 \u041f\u0440\u0438\u0432\u0430\u0442\u043d\u0456\u0441\u0442\u044c. \u041d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0456 \u0432\u0438\u0434\u0430\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u0456 \u043b\u043e\u0433\u0438, \u043f\u0440\u0438\u0432\'\u044f\u0437\u043a\u0430 \u0434\u043e Telegram \u0456 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0438; \u0434\u0456\u044e\u0447\u0430 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0430 \u043f\u0440\u0438 \u0446\u044c\u043e\u043c\u0443 \u0432\u0442\u0440\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f. \u041f\u043e\u0437\u043d\u0430\u0447\u043a\u0430 \u00ab\u0422\u0430\u043a\u043e\u0436 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043b\u043e\u0433\u0438 \u043f\u043e\u0457\u0437\u0434\u043e\u043a \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456\u00bb \u0441\u0442\u0438\u0440\u0430\u0454 \u0439 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0456 \u043b\u043e\u0433\u0438. \u041c\u0430\u0440\u0448\u0440\u0443\u0442\u0438, \u0430\u0434\u0440\u0435\u0441\u0438 \u0439 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456."

