    const-string v14, "\u041a\u043e\u043b\u044c\u043e\u0440\u043e\u0432\u0456 \u043a\u0440\u0430\u043f\u043a\u0438 \u043f\u043e\u0437\u0438\u0446\u0456\u0439"

    const-string v15, "\u041e\u0441\u0442\u0430\u043d\u043d\u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u0457, \u044f\u043a\u0456 \u043f\u0440\u0438\u0439\u043c\u0430\u0454 \u0442\u0435\u043b\u0435\u0444\u043e\u043d: \u0437\u0435\u043b\u0435\u043d\u0430 \u2014 GPS \u0434\u043e\u0432\u0456\u0440\u0435\u043d\u0438\u0439, \u043f\u043e\u043c\u0430\u0440\u0430\u043d\u0447\u0435\u0432\u0430 \u2014 GPS \u0441\u0443\u043c\u043d\u0456\u0432\u043d\u0438\u0439, \u0447\u0435\u0440\u0432\u043e\u043d\u0430 \u2014 GPS \u0432\u0456\u0434\u0445\u0438\u043b\u0435\u043d\u0438\u0439 (\u0433\u043b\u0443\u0448\u0456\u043d\u043d\u044f \u0447\u0438 \u043f\u0456\u0434\u043c\u0456\u043d\u0430), \u043f\u0443\u0440\u043f\u0443\u0440\u043d\u0435 \u043a\u0456\u043b\u044c\u0446\u0435 \u2014 \u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0437\u0430 \u043c\u0435\u0440\u0435\u0436\u0435\u044e (\u0432\u0435\u0436\u0456, Wi-Fi). \u041a\u0440\u0430\u043f\u043a\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u0432\u043e \u0431\u043b\u044f\u043a\u043d\u0443\u0442\u044c \u0456 \u0437\u043d\u0438\u043a\u0430\u044e\u0442\u044c \u0437\u0430 \u043a\u0456\u043b\u044c\u043a\u0430 \u0441\u0435\u043a\u0443\u043d\u0434 (\u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c 20, \u043c\u0435\u0440\u0435\u0436\u0435\u0432\u0456 \u0443\u0434\u0432\u0456\u0447\u0456 \u0434\u043e\u0432\u0448\u0435); \u0442\u0435\u0440\u043c\u0456\u043d \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0432 \u00ab\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u041a\u0430\u0440\u0442\u0430\u00bb, 0 \u0432\u0438\u043c\u0438\u043a\u0430\u0454 \u043a\u0440\u0430\u043f\u043a\u0438. \u0420\u043e\u0437\u0431\u0456\u0436\u043d\u0456\u0441\u0442\u044c \u0437\u0435\u043b\u0435\u043d\u043e\u0457 \u043a\u0440\u0430\u043f\u043a\u0438 \u0439 \u043f\u0443\u0440\u043f\u0443\u0440\u043d\u043e\u0433\u043e \u043a\u0456\u043b\u044c\u0446\u044f \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u0449\u043e GPS \u0431\u0440\u0435\u0448\u0435."

