    const-string v15, "\u041f\u043b\u0430\u0448\u043a\u0430 \u00ab\u041a\u0430\u043c\u0435\u0440\u0430 \u0447\u0435\u0440\u0435\u0437 N \u043c\u00bb \u0437 \u043b\u0456\u043c\u0456\u0442\u043e\u043c. \u0427\u0435\u0440\u0432\u043e\u043d\u0430, \u044f\u043a\u0449\u043e \u0432\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454\u0442\u0435 \u043b\u0456\u043c\u0456\u0442 \u043a\u0430\u043c\u0435\u0440\u0438. \u0413\u043e\u043b\u043e\u0441 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0430\u0454 \u0437\u0430\u0437\u0434\u0430\u043b\u0435\u0433\u0456\u0434\u044c, \u0441\u0438\u0433\u043d\u0430\u043b \u0437\u0432\u0443\u0447\u0438\u0442\u044c \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043d\u0456 \u043f\u043e\u0431\u043b\u0438\u0437\u0443. \u0412\u0456\u0434\u0441\u0442\u0430\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f."

