    const-string v10, "\u00ab\u041f\u043e\u0437\u0438\u0446\u0456\u044f \u043b\u0438\u0448\u0435 \u0437\u0430 \u0432\u0435\u0436\u0435\u044e \u0437\u0432\'\u044f\u0437\u043a\u0443\u00bb"

    const-string v11, "\u0411\u0435\u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443, \u043a\u043e\u043b\u0438 \u043d\u0435\u043c\u0430\u0454 \u043d\u0456 GPS, \u043d\u0456 \u0442\u043e\u0447\u043d\u043e\u0457 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0437\u0430 \u043c\u0435\u0440\u0435\u0436\u0435\u044e: \u0441\u0456\u0440\u0435 \u043a\u043e\u043b\u043e \u043d\u0430\u0432\u043a\u043e\u043b\u043e \u0432\u0435\u0436\u0456 \u0437\u0432\'\u044f\u0437\u043a\u0443 \u0439 \u043f\u0456\u0434\u043f\u0438\u0441 \u0437 \u043f\u043e\u0445\u0438\u0431\u043a\u043e\u044e (\u0431\u0443\u0432\u0430\u0454 \u043a\u0456\u043b\u043e\u043c\u0435\u0442\u0440 \u0456 \u0431\u0456\u043b\u044c\u0448\u0435). \u0426\u0435 \u043d\u0435 \u0432\u0430\u0448\u0435 \u0442\u043e\u0447\u043d\u0435 \u043c\u0456\u0441\u0446\u0435, \u0430 \u043b\u0438\u0448\u0435 \u0440\u0430\u0439\u043e\u043d. \u0417\u043d\u0438\u043a\u0430\u0454, \u0449\u043e\u0439\u043d\u043e \u0437\'\u044f\u0432\u0438\u0442\u044c\u0441\u044f GPS \u0430\u0431\u043e \u0442\u043e\u0447\u043d\u0456\u0448\u0430 \u043c\u0435\u0440\u0435\u0436\u0430."

