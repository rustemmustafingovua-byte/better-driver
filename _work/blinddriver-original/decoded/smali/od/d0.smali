    const-string v1, "REC: \u0437\u0430\u043f\u0438\u0441 \u043b\u043e\u0433\u0443"

    const-string v3, "\u0427\u0435\u0440\u0432\u043e\u043d\u0438\u0439 \u0437 \u043c\u0438\u0433\u043e\u0442\u043b\u0438\u0432\u043e\u044e \u043a\u0440\u0430\u043f\u043a\u043e\u044e \u2014 \u0456\u0434\u0435 \u0437\u0430\u043f\u0438\u0441 \u043b\u043e\u0433\u0443, \u0441\u0456\u0440\u0438\u0439 \u2014 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u041d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0454. \u0423 \u0437\u0431\u0456\u0440\u0446\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0430 \u0437\u0430\u043f\u0438\u0441 \u0432\u043c\u0438\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0441\u0430\u043c \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0443, \u0430 \u0443 \u0432\u0438\u043f\u0443\u0449\u0435\u043d\u0456\u0439 \u0432\u0435\u0440\u0441\u0456\u0457 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e (\u0443 \u043b\u043e\u0433\u0430\u0445 \u0442\u0440\u0435\u043a\u0438 \u043f\u043e\u0457\u0437\u0434\u043e\u043a): \u0432\u043c\u0438\u043a\u0430\u0439\u0442\u0435 REC, \u043a\u043e\u043b\u0438 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u043e\u0433. \u0410\u0432\u0442\u043e\u0437\u0430\u043f\u0438\u0441 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0432 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445. \u041f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0446\u0435\u0439 \u0437\u043d\u0430\u0447\u043e\u043a \u0454 \u0432 \u043d\u0438\u0436\u043d\u0456\u0439 \u043f\u0430\u043d\u0435\u043b\u0456."

