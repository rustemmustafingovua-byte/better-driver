    const-string v7, "\u041e\u0444\u043b\u0430\u0439\u043d-\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438"

    const-string v9, "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u00ab\u041e\u0444\u043b\u0430\u0439\u043d-\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u00bb. \u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0433\u0440\u0430\u0444 \u0434\u043e\u0440\u0456\u0433 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 (287 \u041c\u0411, \u043f\u0456\u0441\u043b\u044f \u0440\u043e\u0437\u043f\u0430\u043a\u0443\u0432\u0430\u043d\u043d\u044f 490 \u041c\u0411; \u043a\u0440\u0430\u0449\u0435 \u043f\u043e Wi-Fi, \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0439\u0434\u0435 \u0443 \u0444\u043e\u043d\u0456 \u0439 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u043e\u0431\u0440\u0438\u0432\u0443 \u0437\u0432\'\u044f\u0437\u043a\u0443). \u0422\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 \u043d\u0435\u043c\u0430\u0454 \u0430\u0431\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u0441\u0435\u0440\u0432\u0456\u0441 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0456\u0432 \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0432, \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0431\u0443\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456, \u0456 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0442\u0435\u0436 \u043f\u0440\u0430\u0446\u044e\u0454. \u041e\u0444\u043b\u0430\u0439\u043d-\u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0431\u0435\u0437 \u0437\u0430\u0442\u043e\u0440\u0456\u0432, \u0437\u043d\u0430\u043a\u0456\u0432 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0439 \u0441\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0456\u0432, \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f, \u043e\u0434\u0438\u043d \u0432\u0430\u0440\u0456\u0430\u043d\u0442. \u0417 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438 \u0431\u0443\u0434\u0443\u044e\u0442\u044c\u0441\u044f \u044f\u043a \u0440\u0430\u043d\u0456\u0448\u0435 (Mapbox \u0456\u0437 \u0432\u0430\u0448\u0438\u043c \u043a\u043b\u044e\u0447\u0435\u043c \u0430\u0431\u043e OSRM)."

