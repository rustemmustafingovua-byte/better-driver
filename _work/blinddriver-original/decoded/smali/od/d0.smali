    const-string v8, "\u2191 \u0411\u0435\u0437 GPS \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u0441\u0442\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u0443 \u0434\u043e\u0440\u043e\u0433\u0443 \u0437\u0430 \u043a\u0443\u0440\u0441\u043e\u043c \u0440\u0443\u0445\u0443 (\u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u0430 50 \u043a\u043c/\u0433\u043e\u0434 \u2014 \u043b\u0438\u0448\u0435 \u043d\u0430 \u0432\u0435\u043b\u0438\u043a\u0456 \u0434\u043e\u0440\u043e\u0433\u0438); \u043d\u0430\u0439\u0442\u043e\u0447\u043d\u0456\u0448\u0435 \u0437 \u043e\u0444\u043b\u0430\u0439\u043d-\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u043c\u0438. \u0412\u0438\u043c\u0438\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u0412\u0435\u0434\u0435\u043d\u043d\u044f."

    invoke-direct {v6, v8}, Lod/g0;-><init>(Ljava/lang/String;)V

    const-string v8, "\u0412\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0431\u0435\u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443"

    const-string v9, "\u041a\u043e\u043b\u0438 \u0442\u043e\u0447\u043a\u0438 A \u0456 B \u043d\u0435 \u0432\u0438\u0431\u0440\u0430\u043d\u043e, \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0441\u0430\u043c \u0432\u0435\u0434\u0435 \u0432\u0430\u0441 \u0437\u0430 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u043c\u0438 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0430\u043c\u0438: \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u043f\u043e\u0437\u0438\u0446\u0456\u044e, \u043a\u0430\u043c\u0435\u0440\u0430 \u043e\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0437\u0430 \u043a\u0443\u0440\u0441\u043e\u043c. \u041f\u0456\u0434 \u0433\u043b\u0443\u0448\u0456\u043d\u043d\u044f\u043c \u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0440\u0430\u0445\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430\u043c\u0438 (\u043a\u0443\u0440\u0441 \u0437\u0430 \u0433\u0456\u0440\u043e\u0441\u043a\u043e\u043f\u043e\u043c \u0456 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u043e\u043c \u043c\u0435\u0440\u0435\u0436\u0435\u0432\u043e\u0433\u043e \u0442\u0440\u0435\u043a\u0443, \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0437\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u043c GPS \u0456 \u043c\u0435\u0440\u0435\u0436\u0435\u044e), \u043c\u0435\u0440\u0435\u0436\u0435\u0432\u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0457\u0457 \u043f\u043e\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u044c. \u0411\u0435\u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u043f\u0440\u0438\u0432\'\u044f\u0437\u043a\u0438 \u0434\u043e \u0434\u043e\u0440\u0456\u0433 \u043d\u0435\u043c\u0430\u0454, \u0442\u043e\u043c\u0443 \u043f\u043e\u0445\u0438\u0431\u043a\u0430 \u0440\u043e\u0441\u0442\u0435 \u0437 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u043d\u044e (\u0441\u0456\u0440\u0430 \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u0437 \u043a\u043e\u043b\u043e\u043c). \u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0438\u0431\u0440\u0430\u043b\u0438 \u0442\u043e\u0447\u043a\u0438 \u0430\u0431\u043e \u043f\u043e\u0431\u0443\u0434\u0443\u0432\u0430\u043b\u0438 \u043c\u0430\u0440\u0448\u0440\u0443\u0442, \u043a\u0430\u043c\u0435\u0440\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0454 \u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0441\u0430\u043c\u0430, \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f."

