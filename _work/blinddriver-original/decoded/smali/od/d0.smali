    const-string v0, "\u041e\u0444\u043b\u0430\u0439\u043d-\u043a\u0430\u0440\u0442\u0430"

    const-string v7, "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u00ab\u041e\u0444\u043b\u0430\u0439\u043d-\u043a\u0430\u0440\u0442\u0430\u00bb. \u041a\u0430\u0440\u0442\u0430 \u0431\u0435\u0440\u0435\u0442\u044c\u0441\u044f \u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 (OpenFreeMap; \u043a\u043b\u044e\u0447 Mapbox \u0434\u043b\u044f \u043d\u0435\u0457 \u043d\u0435 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d). \u00ab\u041a\u0435\u0448\u0443\u0432\u0430\u0442\u0438 \u043a\u0430\u0440\u0442\u0443 \u0432\u0437\u0434\u043e\u0432\u0436 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443\u00bb (\u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e): \u043f\u0456\u0441\u043b\u044f \u0432\u0438\u0431\u043e\u0440\u0443 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u043f\u0456\u0434\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043c\u0443\u0433\u0430 \u00b11,2 \u043a\u043c \u0443\u0437\u0434\u043e\u0432\u0436 \u043d\u044c\u043e\u0433\u043e (\u0431\u043b\u0438\u0437\u044c\u043a\u043e 5-15 \u041c\u0411 \u043d\u0430 10 \u043a\u043c). \u00ab\u041a\u0435\u0448\u0443\u0432\u0430\u0442\u0438 \u043c\u043e\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u00bb (\u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e): \u0442\u0440\u0438\u043c\u0430\u0454 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e\u044e \u043a\u0430\u0440\u0442\u0443 \u043d\u0430\u0432\u043a\u043e\u043b\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u043c\u0456\u0441\u0446\u044f, \u0440\u0430\u0434\u0456\u0443\u0441 25, 50 \u0430\u0431\u043e 100 \u043a\u043c, \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043b\u0438\u0448\u0435 \u043f\u043e Wi-Fi; \u043a\u043e\u043b\u0438 \u0432\u0438 \u0432\u0456\u0434\'\u0457\u0434\u0435\u0442\u0435 \u0434\u0430\u043b\u0435\u043a\u043e, \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u044c\u0441\u044f. \u0411\u0435\u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 \u043a\u0435\u0448\u043e\u0432\u0430\u043d\u0456 \u0434\u0456\u043b\u044f\u043d\u043a\u0438 \u043c\u0430\u043b\u044e\u044e\u0442\u044c\u0441\u044f, \u043d\u043e\u0432\u0456 \u043d\u0456; \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0432\u0436\u0435 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u043c \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c \u043f\u0440\u0430\u0446\u044e\u0454, \u0430 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443, \u043f\u043e\u0448\u0443\u043a \u0430\u0434\u0440\u0435\u0441 \u0456 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430 \u0431\u0435\u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c. \u042f\u043a\u0449\u043e \u043a\u0430\u0440\u0442\u0430 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u043b\u0430\u0441\u044c \u0437\u043e\u0432\u0441\u0456\u043c, \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0456 \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u043c\u0430\u043b\u044e\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u043f\u043e\u0440\u043e\u0436\u043d\u044c\u043e\u043c\u0443 \u0444\u043e\u043d\u0456."

