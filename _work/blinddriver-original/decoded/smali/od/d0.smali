    const-string v8, "\u0412\u0430\u0448 \u0442\u0430\u0440\u0438\u0444: \u00ab\u0423\u0441\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0431\u0435\u0437 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u044c\u00bb (\u043f\u043e\u043a\u0438 \u0442\u0430\u0440\u0438\u0444\u0438 \u043d\u0435 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e), \u00ab\u041f\u0440\u043e\u0431\u043d\u0438\u0439 \u043f\u0435\u0440\u0456\u043e\u0434: \u0449\u0435 N \u0434\u043d\u0456\u0432\u00bb, \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0430 \u0434\u043e \u0434\u0430\u0442\u0438 \u0430\u0431\u043e \u00ab\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439\u00bb \u0437 \u043b\u0456\u043c\u0456\u0442\u043e\u043c \u043f\u043e\u0431\u0443\u0434\u043e\u0432 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456. "

    invoke-static {v8}, Lcd/f;->b(Ljava/lang/String;)Ljava/lang/String;

