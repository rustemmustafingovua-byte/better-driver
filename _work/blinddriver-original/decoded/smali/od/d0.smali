    const-string v15, "\u00ab\u0421\u0445\u043e\u0436\u0435, \u0432\u0438 \u043f\u0440\u043e\u0457\u0445\u0430\u043b\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u00bb"

    move-object/from16 v34, v0

    const-string v0, "\u0415\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e, \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c (\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u0412\u0435\u0434\u0435\u043d\u043d\u044f). \u0411\u0435\u0437 GPS \u043c\u0430\u0440\u043a\u0435\u0440 \u0447\u0435\u043a\u0430\u0454 \u0431\u0456\u043b\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0443, \u0430 \u043c\u0430\u0448\u0438\u043d\u0430 \u0437\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430\u043c\u0438 \u043f\u0440\u043e\u0457\u0445\u0430\u043b\u0430 \u0437\u0430\u0434\u0430\u043d\u0443 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u044c (250 \u043c), \u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0432\u0448\u0438 \u043a\u0435\u0440\u043c\u043e: \u0442\u0430\u043a\u0430 \u0441\u0430\u043c\u0430 \u043f\u043b\u0430\u0448\u043a\u0430 \u0437 \u0432\u0456\u0434\u043b\u0456\u043a\u043e\u043c \u0456 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u043e\u044e. \u041c\u043e\u0436\u0435 \u0441\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0445\u0438\u0431\u043d\u043e, \u0431\u043e \u0431\u0435\u0437 GPS \u043c\u0430\u0440\u043a\u0435\u0440 \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043e \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0443 \u0440\u0430\u043d\u0456\u0448\u0435 \u0437\u0430 \u043c\u0430\u0448\u0438\u043d\u0443."

