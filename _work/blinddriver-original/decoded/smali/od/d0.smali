    const-string v5, "\u0410\u0432\u0442\u043e-\u043c\u0430\u0441\u0448\u0442\u0430\u0431"

    const-string v7, "\u041f\u0456\u0434\u0441\u0432\u0456\u0447\u0435\u043d\u0438\u0439, \u043a\u043e\u043b\u0438 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u0438\u0439. \u0427\u0438\u043c \u0448\u0432\u0438\u0434\u0448\u0435 \u0432\u0438 \u0457\u0434\u0435\u0442\u0435, \u0442\u0438\u043c \u0434\u0440\u0456\u0431\u043d\u0456\u0448\u0438\u0439 \u043c\u0430\u0441\u0448\u0442\u0430\u0431 (\u0434\u0430\u043b\u0456 \u0432\u0438\u0434\u043d\u043e \u0432\u043f\u0435\u0440\u0435\u0434); \u0437\u0430 350 \u043c \u0434\u043e \u043c\u0430\u043d\u0435\u0432\u0440\u0443 \u043a\u0430\u0440\u0442\u0430 \u043f\u043b\u0430\u0432\u043d\u043e \u043d\u0430\u0431\u043b\u0438\u0436\u0430\u0454\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u0431\u0443\u043b\u043e \u0432\u0438\u0434\u043d\u043e \u043f\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u0442\u044f. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u0432\u0438\u043c\u0438\u043a\u0430\u0454 \u00abAuto\u00bb \u0456 \u043b\u0438\u0448\u0430\u0454 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u043c\u0430\u0441\u0448\u0442\u0430\u0431; \u00ab+\u00bb \u0456 \u00ab\u2212\u00bb \u0442\u0430\u043a\u043e\u0436 \u0439\u043e\u0433\u043e \u0432\u0438\u043c\u0438\u043a\u0430\u044e\u0442\u044c. \u0412\u0438\u0431\u0456\u0440 \u0437\u0430\u043f\u0430\u043c\'\u044f\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f."

