    const-string v2, "W"

    invoke-direct {v1, v2}, Lod/g0;-><init>(Ljava/lang/String;)V

    const-string v2, "\u0423 Waze \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u041f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u043f\u043e\u0457\u0437\u0434\u043a\u043e\u044e\u00bb \u0456 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c BlindDriver, \u0430\u0431\u043e \u0432\u0441\u0442\u0430\u0432\u0442\u0435 \u0442\u0430\u043a\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0432 \u0440\u044f\u0434\u043e\u043a \u00ab\u041a\u0443\u0434\u0438\u00bb. \u0417\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0432\u0456\u0437\u044c\u043c\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 Waze, \u043f\u0440\u0438\u0432\'\u044f\u0436\u0435 \u0439\u043e\u0433\u043e \u0434\u043e \u0434\u043e\u0440\u0456\u0433, \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0439 \u043f\u043e\u0432\u0435\u0440\u043d\u0435 \u0432\u0430\u0441 \u0443 Waze: \u00ab\u041d\u0430\u0437\u0430\u0434\u00bb \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 \u0443 Waze, \u043d\u0435 \u0437\u0443\u043f\u0438\u043d\u044f\u044e\u0447\u0438 \u0432\u0435\u0434\u0435\u043d\u043d\u044f. \u041f\u0440\u0430\u0446\u044e\u0454, \u043f\u043e\u043a\u0438 \u0442\u0440\u0438\u0432\u0430\u0454 \u043f\u043e\u0457\u0437\u0434\u043a\u0430 \u0432 Waze, \u0456 \u043b\u0438\u0448\u0435 \u0437 \u043a\u043b\u044e\u0447\u0435\u043c Mapbox. \u0426\u0435 \u043d\u0435\u043e\u0444\u0456\u0446\u0456\u0439\u043d\u0438\u0439 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 Waze: \u0432\u0456\u043d \u043c\u043e\u0436\u0435 \u0437\u043c\u0456\u043d\u0438\u0442\u0438\u0441\u044f."

    invoke-static {v2}, Lcd/f;->b(Ljava/lang/String;)Ljava/lang/String;

