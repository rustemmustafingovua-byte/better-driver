    const-string v7, "\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0430 \u0437\u043d\u0430\u0447\u043e\u043a \u0441\u0442\u0430\u043d\u0443 GPS \u0443 \u0432\u0435\u0440\u0445\u043d\u044c\u043e\u043c\u0443 \u0440\u044f\u0434\u0443. \u041f\u0430\u043d\u0435\u043b\u044c \u0434\u043b\u044f \u043d\u0430\u043b\u0430\u0433\u043e\u0434\u0436\u0435\u043d\u043d\u044f: \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0438 GPS \u0456 \u043c\u0435\u0440\u0435\u0436\u0456, \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0438, \u0440\u0456\u0432\u0435\u043d\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u0443 (C/N0, AGC), \u0434\u0430\u0442\u0447\u0438\u043a\u0438. \u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u00ab\u0411\u0435\u0437 GPS\u00bb \u0432\u043c\u0438\u043a\u0430\u0454 \u0442\u0435\u0441\u0442 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u043e\u0432\u043e\u0433\u043e \u0432\u0435\u0434\u0435\u043d\u043d\u044f: \u0444\u0456\u043a\u0441\u0438 GPS \u043b\u0438\u0448\u0435 \u043f\u0438\u0448\u0443\u0442\u044c\u0441\u044f \u0432 \u043b\u043e\u0433."

