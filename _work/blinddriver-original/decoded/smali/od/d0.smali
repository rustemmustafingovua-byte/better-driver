    const-string v6, "\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u0420\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438\u00bb. \u0417\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0432\u0435\u0434\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u043c \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e \u0456 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0454 \u0432\u0435\u0441\u0442\u0438, \u043d\u0430\u0432\u0456\u0442\u044c \u043a\u043e\u043b\u0438 GPS \u0437\u0430\u0433\u043b\u0443\u0448\u0435\u043d\u043e \u0430\u0431\u043e \u0431\u0440\u0435\u0448\u0435."

