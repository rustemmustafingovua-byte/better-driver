    const-string v3, "\u041e\u0431\u0438\u0440\u0430\u044e\u0442\u044c, \u044f\u043a\u0443 \u0442\u043e\u0447\u043a\u0443 \u0432\u0438 \u0437\u0430\u0440\u0430\u0437 \u0437\u0430\u0434\u0430\u0454\u0442\u0435 (A \u2014 \u0441\u0442\u0430\u0440\u0442, B \u2014 \u0444\u0456\u043d\u0456\u0448, \u00ab\u0447\u0435\u0440\u0435\u0437\u00bb \u2014 \u043f\u0440\u043e\u043c\u0456\u0436\u043d\u0430). \u042f\u043a\u0449\u043e \u0442\u043e\u0447\u043a\u0430 \u0432\u0436\u0435 \u0454, \u0432\u043e\u043d\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0456."

