    const-string v10, "\u041f\u0435\u0440\u0435\u0434 \u043a\u0440\u0443\u0442\u0438\u043c \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u043c \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u043c\u0430\u0440\u043a\u0435\u0440 \u0447\u0435\u043a\u0430\u0454, \u043f\u043e\u043a\u0438 \u0433\u0456\u0440\u043e\u0441\u043a\u043e\u043f \u043d\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c, \u0449\u043e \u0432\u0438 \u0441\u043f\u0440\u0430\u0432\u0434\u0456 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u043b\u0438 \u043a\u0435\u0440\u043c\u043e (\u043f\u043e\u0432\u0456\u043b\u044c\u043d\u0438\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442 \u0442\u0435\u0436 \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0454\u0442\u044c\u0441\u044f), \u0456 \u043b\u0438\u0448\u0435 \u0442\u043e\u0434\u0456 \u00ab\u043f\u0440\u0438\u0449\u0456\u043f\u043b\u044e\u0454\u0442\u044c\u0441\u044f\u00bb \u0434\u043e \u043f\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u0442\u044f. \u0422\u0430\u043a \u043c\u0430\u0440\u043a\u0435\u0440 \u043d\u0435 \u043f\u0440\u043e\u0457\u0436\u0434\u0436\u0430\u0454 \u043f\u043e\u0432\u043e\u0440\u043e\u0442 \u0440\u0430\u043d\u0456\u0448\u0435 \u0437\u0430 \u0432\u0430\u0441."

