    const-string v13, "\u041e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0430 \u0434\u0456\u043b\u044f\u043d\u0446\u0456 (\u0437\u0430 \u0434\u0430\u043d\u0438\u043c\u0438 Mapbox), \u043d\u0430 \u043a\u0430\u0440\u0442\u0456 \u0432 \u043b\u0456\u0432\u043e\u043c\u0443 \u043d\u0438\u0436\u043d\u044c\u043e\u043c\u0443 \u043a\u0443\u0442\u0456 \u043d\u0430\u0434 \u043f\u0430\u043d\u0435\u043b\u043b\u044e \u0432\u0435\u0434\u0435\u043d\u043d\u044f. \u0421\u0442\u0430\u0454 \u0447\u0435\u0440\u0432\u043e\u043d\u0438\u043c, \u043a\u043e\u043b\u0438 \u0432\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454\u0442\u0435 \u043b\u0456\u043c\u0456\u0442 \u043f\u043e\u043d\u0430\u0434 \u0434\u043e\u043f\u0443\u0441\u043a."

