    const-string v9, "\u0410\u043a\u0441\u0435\u043b\u0435\u0440\u043e\u043c\u0435\u0442\u0440 \u0456 \u0433\u0456\u0440\u043e\u0441\u043a\u043e\u043f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c, \u0449\u043e \u043c\u0430\u0448\u0438\u043d\u0430 \u0441\u0442\u043e\u0457\u0442\u044c (\u043f\u0440\u0430\u0446\u044e\u0454 \u0456 \u0432 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0456\u043b\u044f, \u0434\u0435 \u043d\u0435\u043c\u0430\u0454 \u0432\u0456\u0431\u0440\u0430\u0446\u0456\u0457 \u0434\u0432\u0438\u0433\u0443\u043d\u0430). \u041c\u0430\u0440\u043a\u0435\u0440 \u0437\u0443\u043f\u0438\u043d\u044f\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0437\u0443\u043f\u0438\u043d\u0438\u043b\u0438\u0441\u044f \u0432\u0438."

