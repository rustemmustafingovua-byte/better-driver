    const-string v1, "\u0417\u0441\u0443\u0432\u0430\u0454 \u043c\u0430\u0440\u043a\u0435\u0440 \u043d\u0430 100 \u043c \u0443\u043f\u0435\u0440\u0435\u0434 \u0437\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c. \u0423\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u044e\u0454 \u0437\u0456 \u0437\u0440\u043e\u0441\u0442\u0430\u044e\u0447\u0438\u043c \u043a\u0440\u043e\u043a\u043e\u043c (100, 200, 500, 1000 \u043c), \u043d\u0430 \u043a\u043d\u043e\u043f\u0446\u0456 \u0432\u0438\u0434\u043d\u043e \u0441\u0443\u043c\u0443. \u041f\u0456\u0441\u043b\u044f \u043f\u043e\u043f\u0440\u0430\u0432\u043a\u0438 30 \u0441 GPS \u0437 \u043d\u0435\u044e \u043d\u0435 \u0441\u043f\u0435\u0440\u0435\u0447\u0430\u0454\u0442\u044c\u0441\u044f."

