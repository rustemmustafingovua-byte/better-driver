    const-string v5, "\u041e\u0444\u043b\u0430\u0439\u043d-\u043f\u043e\u0448\u0443\u043a \u0430\u0434\u0440\u0435\u0441"

    const-string v7, "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u00ab\u041e\u0444\u043b\u0430\u0439\u043d-\u043f\u043e\u0448\u0443\u043a \u0430\u0434\u0440\u0435\u0441\u00bb. \u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0438 \u0442\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439, \u0434\u0435 \u0432\u0438 \u0431\u0443\u0432\u0430\u0454\u0442\u0435 (\u043a\u043e\u0436\u0435\u043d \u0432\u0456\u0434 \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0434\u043e \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0434\u0435\u0441\u044f\u0442\u043a\u0456\u0432 \u041c\u0411; \u0454 \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0432\u0441\u0456 \u043e\u0431\u043b\u0430\u0441\u0442\u0456\u00bb), \u043e\u0434\u0438\u043d \u0440\u0430\u0437. \u0421\u043f\u0438\u0441\u043e\u043a \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0438\u0439: \u0432\u0438\u0434\u043d\u043e \u043b\u0438\u0448\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0434\u0435 \u0432\u0438 \u0437\u0430\u0440\u0430\u0437, \u0456 \u0442\u0456, \u0434\u043b\u044f \u044f\u043a\u0438\u0445 \u0454 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f; \u0440\u0435\u0448\u0442\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u0440\u044f\u0434\u043a\u043e\u043c \u00ab\u0423\u0441\u0456 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 (N, \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e M) \u25bc\u00bb. \u0422\u043e\u0434\u0456 \u0440\u044f\u0434\u043e\u043a \u00ab\u041a\u0443\u0434\u0438 (\u0430\u0434\u0440\u0435\u0441\u0430)\u00bb \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u0432\u0443\u043b\u0438\u0446\u0456, \u0431\u0443\u0434\u0438\u043d\u043a\u0438 (\"\u0425\u0440\u0435\u0449\u0430\u0442\u0438\u043a 22\", \"\u0412\u0435\u0440\u0445\u043e\u0432\u0438\u043d\u043d\u0430 87\"), \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0456 \u043f\u0443\u043d\u043a\u0442\u0438 \u0456 \u043c\u0456\u0441\u0446\u044f (\u0430\u043f\u0442\u0435\u043a\u0430, \u0432\u043e\u043a\u0437\u0430\u043b) \u0431\u0435\u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443, \u0437\u0430 \u043d\u0430\u0437\u0432\u0430\u043c\u0438 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e \u0439 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u043e\u044e, \u0456\u0437 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f\u043c \u0434\u0440\u0456\u0431\u043d\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a; \u0431\u043b\u0438\u0436\u0447\u0456 \u0434\u043e \u0432\u0430\u0441 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 \u0432\u0433\u043e\u0440\u0456. \u0417 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u0439 \u0434\u0430\u043b\u0456 \u0434\u0430\u0454 \u043e\u043d\u043b\u0430\u0439\u043d-\u043f\u043e\u0448\u0443\u043a, \u0430 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u043f\u0456\u0434\u043a\u0430\u0437\u0443\u0454, \u043a\u043e\u043b\u0438 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 \u043d\u0435\u043c\u0430\u0454 \u0430\u0431\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u043f\u043e\u0448\u0443\u043a \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043e\u0432. \u041a\u0430\u0442\u0430\u043b\u043e\u0433 \u0437\u0456\u0431\u0440\u0430\u043d\u043e \u0437 OpenStreetMap: \u0443 \u043c\u0456\u0441\u0442\u0456 \u0430\u0434\u0440\u0435\u0441\u0438 \u043f\u043e\u0432\u043d\u0456, \u0443 \u0441\u0435\u043b\u0430\u0445 \u0433\u0456\u0440\u0448\u0435."

