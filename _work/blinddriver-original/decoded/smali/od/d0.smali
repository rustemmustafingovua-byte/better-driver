    const-string v15, "\u0421\u0445\u0456\u0434 \u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443"

    move-object/from16 v32, v0

    const-string v0, "\u0417 \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u043c GPS \u0441\u0445\u0456\u0434 \u0437\u0430\u0440\u0430\u0445\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0432\u0438 \u0434\u0430\u043b\u0456 \u0432\u0456\u0434 \u043b\u0456\u043d\u0456\u0457 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443, \u043d\u0456\u0436 \u0437\u0430\u0434\u0430\u043d\u043e \u0432 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 (50 \u043c \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 8 \u0441), \u0430\u0431\u043e \u0440\u0430\u043d\u0456\u0448\u0435 \u2014 \u043a\u043e\u043b\u0438 \u0432\u0438 \u0432\u0436\u0435 \u0437\u0430 30 \u043c \u0432\u0456\u0434 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u0456 \u0457\u0434\u0435\u0442\u0435 \u043d\u0435 \u0442\u0443\u0434\u0438, \u043a\u0443\u0434\u0438 \u0432\u0456\u043d \u0432\u0435\u0434\u0435 (\u043a\u0443\u0440\u0441 \u0440\u043e\u0437\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0443 \u0431\u0456\u043b\u044c\u0448 \u043d\u0456\u0436 \u043d\u0430 40\u00b0, 3 \u0441). \u041f\u043e\u043a\u0438 \u0432\u0438 \u043f\u043e\u0437\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c, \u043c\u0430\u0440\u043a\u0435\u0440 \u0441\u0442\u043e\u0457\u0442\u044c \u0442\u0430\u043c, \u0434\u0435 \u0432\u0438 \u0454 \u0437\u0430 GPS, \u0430 \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u0432\u0430\u0448 \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0439 \u043a\u0443\u0440\u0441, \u0430 \u043d\u0435 \u043d\u0430\u043f\u0440\u044f\u043c\u043e\u043a \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443."

    invoke-direct {v1, v14, v15, v0}, Lod/j0;-><init>(Lod/i0;Ljava/lang/String;Ljava/lang/String;)V

