    const-string v13, "\u0412\u0430\u0448 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0438\u0439 \u043a\u043b\u044e\u0447 (pk.\u2026) \u0434\u043b\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0456\u0432 \u0456\u0437 \u0437\u0430\u0442\u043e\u0440\u0430\u043c\u0438. \u0411\u0435\u0437 \u043a\u043b\u044e\u0447\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438 \u0431\u0443\u0434\u0443\u044e\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437 OSRM \u0431\u0435\u0437 \u0437\u0430\u0442\u043e\u0440\u0456\u0432. \u041a\u043b\u044e\u0447 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u043c \u043b\u0438\u0448\u0435 \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456."

