    const-string v3, "\u041f\u0440\u043e\u043c\u0456\u0436\u043d\u0456 \u0442\u043e\u0447\u043a\u0438"

    const-string v15, "\u0421\u0456\u0440\u0456 \u043f\u043e\u0437\u043d\u0430\u0447\u043a\u0438 \u00ab\u0447\u0435\u0440\u0435\u0437: 1 \u2715\u00bb. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u043f\u0440\u0438\u0431\u0440\u0430\u0442\u0438 \u043f\u0440\u043e\u043c\u0456\u0436\u043d\u0443 \u0442\u043e\u0447\u043a\u0443. \u0414\u043e\u0432\u0433\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0456 \u0437 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u043c \u0447\u0438\u043f\u043e\u043c \u00ab\u0447\u0435\u0440\u0435\u0437\u00bb \u0434\u043e\u0434\u0430\u0454 \u043d\u043e\u0432\u0443."

