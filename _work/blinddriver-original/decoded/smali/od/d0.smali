    const-string v9, "\u0421\u0456\u0440\u0430 \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u0437 \u043a\u043e\u043b\u043e\u043c"

    const-string v10, "\u0420\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u043e\u0432\u0430 \u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0431\u0435\u0437 \u0434\u043e\u0432\u0456\u0440\u0435\u043d\u043e\u0433\u043e GPS. \u041a\u043e\u043b\u043e \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u043c\u043e\u0436\u043b\u0438\u0432\u0443 \u043f\u043e\u0445\u0438\u0431\u043a\u0443: \u0447\u0438\u043c \u0434\u043e\u0432\u0448\u0435 \u043d\u0435\u043c\u0430\u0454 GPS, \u0442\u0438\u043c \u0432\u043e\u043d\u043e \u0431\u0456\u043b\u044c\u0448\u0435."

