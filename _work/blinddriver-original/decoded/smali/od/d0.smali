    invoke-direct {v2, v7}, Lod/g0;-><init>(Ljava/lang/String;)V

    const-string v9, "\u0421\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0438, \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438, \u043f\u0435\u0440\u0435\u0457\u0437\u0434\u0438"

    const-string v10, "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u2192 \u041a\u0430\u0440\u0442\u0430 \u0439 \u043e\u0444\u043b\u0430\u0439\u043d \u2192 \u00ab\u0421\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0438, \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438, \u043f\u0435\u0440\u0435\u0457\u0437\u0434\u0438\u00bb. \u0411\u0430\u0437\u0430 \u0437 OpenStreetMap \u043f\u043e \u0432\u0441\u0456\u0439 \u0423\u043a\u0440\u0430\u0457\u043d\u0456: \u0441\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0438, \u043b\u0435\u0436\u0430\u0447\u0456 \u043f\u043e\u043b\u0456\u0441\u043c\u0435\u043d\u0438, \u043f\u0456\u0448\u043e\u0445\u0456\u0434\u043d\u0456 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438 \u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438 \u0447\u0435\u0440\u0435\u0437 \u0432\u0435\u043b\u043e\u0434\u043e\u0440\u0456\u0436\u043a\u0438, \u0437\u0430\u043b\u0456\u0437\u043d\u0438\u0447\u043d\u0456 \u043f\u0435\u0440\u0435\u0457\u0437\u0434\u0438. \u0412\u043e\u043d\u0430 \u0432\u0448\u0438\u0442\u0430 \u0432 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0456 \u043f\u0440\u0430\u0446\u044e\u0454 \u0431\u0435\u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443; \u0437\u043d\u0430\u0447\u043a\u0438 \u043d\u0430 \u043a\u0430\u0440\u0442\u0456 \u0437 15-\u0433\u043e \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443. \u0413\u043e\u043b\u043e\u0441\u043e\u043c \u043f\u0440\u043e \u043d\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u043d\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0430\u0454. \u0420\u0430\u0437 \u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0430 \u0434\u043d\u0456\u0432, \u043a\u043e\u043b\u0438 \u0454 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442, \u0431\u0430\u0437\u0430 \u043e\u043d\u043e\u0432\u043b\u044e\u0454\u0442\u044c\u0441\u044f \u0441\u0430\u043c\u0430 (\u0431\u043b\u0438\u0437\u044c\u043a\u043e 0,6 \u041c\u0411)."

