    const-string v14, "\u041d\u0430\u0431\u043e\u0440\u0438 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u043a\u0442\u043e\u0440\u0430 \u0437\u0443\u043f\u0438\u043d\u043a\u0438: \u00ab\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0439\u00bb (\u0441\u0430\u043c \u043f\u0456\u0434\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0432\u0430\u0448\u0443 \u043c\u0430\u0448\u0438\u043d\u0443 \u0439 \u0442\u0440\u0438\u043c\u0430\u0447, \u043f\u043e\u043a\u0438 GPS \u0434\u043e\u0431\u0440\u0438\u0439, \u0456 \u043d\u0435 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0454 \u0431\u0456\u043b\u044c\u0448\u0435 \u0445\u0438\u0431\u043d\u0438\u0445 \u0437\u0443\u043f\u0438\u043d\u043e\u043a, \u043d\u0456\u0436 \u0442\u0438\u043f\u043e\u0432\u0456 \u043f\u043e\u0440\u043e\u0433\u0438), \u00ab\u041e\u0431\u0435\u0440\u0435\u0436\u043d\u0438\u0439\u00bb \u0456 \u00ab\u0427\u0443\u0442\u043b\u0438\u0432\u0438\u0439\u00bb (\u0440\u0443\u0447\u043d\u0456, \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0456), \u0430 \u0442\u0430\u043a\u043e\u0436 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438."

