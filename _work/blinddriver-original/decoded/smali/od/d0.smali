    const-string v2, "\u0420\u044f\u0434\u043e\u043a \u00ab\u041a\u0443\u0434\u0438 (\u0430\u0434\u0440\u0435\u0441\u0430)\u00bb"

    const-string v3, "\u041f\u0456\u0434\u043a\u0430\u0437\u043a\u0430 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0456 \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438: \u00ab\u0417\u0432\u0456\u0434\u043a\u0438\u00bb, \u00ab\u041a\u0443\u0434\u0438\u00bb \u0430\u0431\u043e \u00ab\u0427\u0435\u0440\u0435\u0437\u00bb. \u041f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u0430\u0434\u0440\u0435\u0441 \u0437\'\u044f\u0432\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0440\u044f\u0434\u043a\u043e\u043c."

