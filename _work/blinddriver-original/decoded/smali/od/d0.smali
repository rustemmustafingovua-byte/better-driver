    const-string v8, "\u0414\u043e\u0432\u0456\u0440\u0435\u043d\u0438\u0439 GPS \u0437\u043d\u0438\u043a\u0430\u0454 (\u0433\u043b\u0443\u0448\u0456\u043d\u043d\u044f, \u043f\u0456\u0434\u043c\u0456\u043d\u0430 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0430\u0431\u043e \u0442\u0443\u043d\u0435\u043b\u044c). \u041c\u0430\u0440\u043a\u0435\u0440 \u043d\u0435 \u0437\u0430\u0432\u043c\u0438\u0440\u0430\u0454: \u0432\u0456\u043d \u0457\u0434\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c \u0456\u0437 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044e, \u044f\u043a\u0443 \u043e\u0446\u0456\u043d\u0435\u043d\u043e \u0437\u0430 GPS \u0434\u043e \u0432\u0442\u0440\u0430\u0442\u0438, \u043b\u0456\u043c\u0456\u0442\u043e\u043c \u0434\u043e\u0440\u043e\u0433\u0438 \u0439 \u043f\u043e\u0437\u0438\u0446\u0456\u0454\u044e \u0432\u0456\u0434 \u043c\u0435\u0440\u0435\u0436\u0456."

