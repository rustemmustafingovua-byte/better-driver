    const-string v3, "\u0417\u0435\u043b\u0435\u043d\u0438\u0439 A \u0456 \u0447\u0435\u0440\u0432\u043e\u043d\u0438\u0439 B"

    const-string v13, "\u0422\u043e\u0447\u043a\u0438 \u0441\u0442\u0430\u0440\u0442\u0443 \u0456 \u0444\u0456\u043d\u0456\u0448\u0443. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440, \u0449\u043e\u0431 \u0443\u0437\u044f\u0442\u0438 \u0439\u043e\u0433\u043e \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043d\u044f: \u043f\u0456\u0434 \u043d\u0438\u043c \u0437\'\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u0442\u044f, \u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u041f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0442\u0443\u0442\u00bb \u0437\u0430\u0444\u0456\u043a\u0441\u0443\u0454 \u043d\u043e\u0432\u0435 \u043c\u0456\u0441\u0446\u0435."

