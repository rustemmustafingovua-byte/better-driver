    const-string v2, "((\u2022))"

    invoke-direct {v1, v2}, Lod/g0;-><init>(Ljava/lang/String;)V

    const-string v2, "\u041a\u0440\u0443\u0433\u043b\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u0437\u0456 \u0437\u043d\u0430\u0447\u043a\u043e\u043c \u0440\u0430\u0434\u0456\u043e\u0445\u0432\u0438\u043b\u044c \u00ab((\u2022))\u00bb \u043f\u0456\u0434 \u0437\u043d\u0430\u0447\u043a\u043e\u043c GPS (\u043f\u043e\u0440\u0443\u0447 \u0437\u0456 \u0437\u043d\u0430\u0447\u043a\u043e\u043c \u0442\u0440\u0438\u0432\u043e\u0433\u0438; \u0446\u0435 \u043d\u0435 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u0439\u043e\u043c\u0443 GPS, \u0430 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0456): \u0437\u0435\u043b\u0435\u043d\u0430 \u2014 \u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0432\u0456\u0434\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0456\u043d\u0448\u0438\u043c \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0430\u043c, \u0441\u0438\u043d\u044f \u2014 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u0430\u043b\u0435 GPS \u0443 \u043d\u043e\u0440\u043c\u0456, \u0441\u0456\u0440\u0430 \u2014 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u041a\u043e\u043b\u0438 \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u044c\u043e\u0433\u043e GPS \u043d\u0435\u043c\u0430\u0454, Waze \u0456 \u043a\u0430\u0440\u0442\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u043f\u043e\u0437\u0438\u0446\u0456\u044e BlindDriver. \u041f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 BlindDriver \u0443 \u00ab\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0430 \u2192 \u0417\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0434\u043b\u044f \u0444\u0456\u043a\u0442\u0438\u0432\u043d\u0438\u0445 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u044c\u00bb \u0456 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u00ab\u041f\u043e\u043a\u0430\u0437 \u043f\u043e\u0432\u0435\u0440\u0445 \u0456\u043d\u0448\u0438\u0445 \u0432\u0456\u043a\u043e\u043d\u00bb: \u0442\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 BlindDriver \u0437\u0433\u043e\u0440\u043d\u0443\u0442\u043e, \u043f\u043e\u0432\u0435\u0440\u0445 Waze \u043f\u043e\u043a\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430 \u043a\u0430\u0440\u0442\u0430 \u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c \u0456 \u043a\u043d\u043e\u043f\u043a\u0430\u043c\u0438 \u2191100, \u2193100 \u0456 \u21bb; \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0443 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a. \u041f\u043e\u043a\u0438 \u0439\u0434\u0435 \u043f\u0456\u0434\u043c\u0456\u043d\u0430, \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0441\u0442\u0435\u0436\u0438\u0442\u044c \u0437\u0430 \u0441\u0442\u0430\u043d\u043e\u043c \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0456\u0432: \u043a\u043e\u043b\u0438 \u043f\u0440\u0438\u0439\u043c\u0430\u0447 \u0437\u043d\u043e\u0432\u0443 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0438 \u0431\u0435\u0437 \u043e\u0437\u043d\u0430\u043a \u0433\u043b\u0443\u0448\u0456\u043d\u043d\u044f, \u043f\u0456\u0434\u043c\u0456\u043d\u0430 \u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0430 \u0441\u0435\u043a\u0443\u043d\u0434 \u0437\u043d\u0456\u043c\u0430\u0454\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0439 GPS (Waze \u043d\u0430 \u0446\u0435\u0439 \u0447\u0430\u0441 \u0431\u0430\u0447\u0438\u0442\u044c \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0439 GPS). \u041f\u0456\u0434 \u0433\u043b\u0443\u0448\u0456\u043d\u043d\u044f\u043c \u0442\u0430\u043a\u0438\u0445 \u043f\u0430\u0443\u0437 \u043d\u0435\u043c\u0430\u0454."

    invoke-static {v2}, Lcd/f;->b(Ljava/lang/String;)Ljava/lang/String;

