    const-string v7, "\u0412\u0438\u0445\u0456\u0434: \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u041d\u0430\u0437\u0430\u0434\u00bb"

    const-string v9, "\u0414\u0432\u0456\u0447\u0456 \u043f\u043e\u0441\u043f\u0456\u043b\u044c \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u043c\u0443 \u0435\u043a\u0440\u0430\u043d\u0456 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u0430\u043a\u0440\u0438\u0432\u0430\u0454 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a: \u0437\u0443\u043f\u0438\u043d\u044f\u0454 \u0437\u0430\u043f\u0438\u0441 \u043b\u043e\u0433\u0443, \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0456 \u0441\u043b\u0443\u0436\u0431\u0443. \u041f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0442\u0440\u0438\u0447\u0456 \u043f\u043e\u0441\u043f\u0456\u043b\u044c (\u0449\u043e\u0431 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e \u043d\u0435 \u0437\u0430\u043a\u0440\u0438\u0442\u0438 \u043d\u0430\u0432\u0456\u0433\u0430\u0442\u043e\u0440 \u0434\u043e\u0440\u043e\u0433\u043e\u044e). \u0421\u043f\u0435\u0440\u0448\u0443 \u00ab\u041d\u0430\u0437\u0430\u0434\u00bb \u0437\u0430\u043a\u0440\u0438\u0432\u0430\u0454 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0456 \u043f\u0430\u043d\u0435\u043b\u0456. \u042f\u043a\u0449\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a, \u0431\u0435\u0437 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0432\u043e\u043d\u043e \u0447\u0435\u0440\u0435\u0437 2 \u0445\u0432\u0438\u043b\u0438\u043d\u0438 \u0441\u0430\u043c\u0435 \u0437\u0443\u043f\u0438\u043d\u044f\u0454 \u0437\u0430\u043f\u0438\u0441 \u0456 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 (\u0443 \u0444\u043e\u043d\u0456 Android \u0432\u0441\u0435 \u043e\u0434\u043d\u043e \u043d\u0435 \u0432\u0456\u0434\u0434\u0430\u0454 \u0457\u0445 \u0431\u0435\u0437 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u0435\u0434\u0435\u043d\u043d\u044f)."

