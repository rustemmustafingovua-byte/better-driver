    const-string v11, "\u041f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u0430 \u0442\u0440\u0438\u0432\u043e\u0433\u0430"

    const-string v12, "\u041a\u0440\u0443\u0433\u043b\u0430 \u043f\u043e\u0437\u043d\u0430\u0447\u043a\u0430 \u043f\u0456\u0434 \u0437\u043d\u0430\u0447\u043a\u043e\u043c GPS: \u0447\u0435\u0440\u0432\u043e\u043d\u0430 \u0447\u0438 \u0436\u043e\u0432\u0442\u0430 \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0440\u0430\u0439\u043e\u043d\u0456 \u0430\u0431\u043e \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u2014 \u0440\u0456\u0432\u0435\u043d\u044c \u0437\u0430 ukrainealarm (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u00ab\u0414\u0440\u043e\u043d\u043e\u0432\u0430 \u0437\u0430\u0433\u0440\u043e\u0437\u0430 (\u0436\u043e\u0432\u0442\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c)\u00bb); \u0436\u043e\u0432\u0442\u0430 \u2014 \u0442\u0430\u043a\u043e\u0436 \u0442\u0440\u0438\u0432\u043e\u0433\u0430 \u043f\u043e\u0440\u0443\u0447 (\u0441\u0443\u0441\u0456\u0434\u043d\u0456\u0439 \u0440\u0430\u0439\u043e\u043d, \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u0440\u0430\u0439\u043e\u043d\u0443 \u0447\u0438 \u0456\u043d\u0448\u0438\u0439 \u0440\u0430\u0439\u043e\u043d \u043e\u0431\u043b\u0430\u0441\u0442\u0456). \u041d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u043f\u043e\u0447\u0430\u0442\u043e\u043a, \u0440\u0456\u0432\u0435\u043d\u044c \u0456 \u0440\u0430\u0439\u043e\u043d, \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u0435 \u2014 \u0445\u043e\u0432\u0430\u0454. \u0421\u043c\u0443\u0433\u0430 \u0437\u0432\u0435\u0440\u0445\u0443 \u0437\'\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u043d\u043e\u0432\u0456\u0439 \u0442\u0440\u0438\u0432\u043e\u0437\u0456 \u0447\u0438 \u0437\u043c\u0456\u043d\u0456 \u0440\u0456\u0432\u043d\u044f; \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u0457\u0457 \u0437\u0433\u043e\u0440\u0442\u0430\u0454. \u041f\u0440\u043e \u043d\u043e\u0432\u0443 \u0442\u0440\u0438\u0432\u043e\u0433\u0443, \u0437\u043c\u0456\u043d\u0443 \u0440\u0456\u0432\u043d\u044f \u0439 \u0432\u0456\u0434\u0431\u0456\u0439 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u043a\u0430\u0436\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u043c (\u044f\u043a\u0449\u043e \u043e\u0437\u0432\u0443\u0447\u0435\u043d\u043d\u044f \u043d\u0435 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0435), \u0430 \u043a\u043e\u043b\u0438 \u0432\u0456\u043d \u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0438\u0439 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0435\u0434\u0435\u043d\u043d\u044f \u2014 \u0449\u0435 \u0439 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f\u043c. \u0414\u0430\u043d\u0456 ukrainealarm.com; \u0440\u0430\u0439\u043e\u043d \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456, \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0438 \u043d\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u044e\u0442\u044c\u0441\u044f."

