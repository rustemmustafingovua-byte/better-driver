    const-string v5, "\u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u00ab+\u00bb \u0456 \u00ab\u2212\u00bb"

    const-string v7, "\u0414\u0432\u0456 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u0456\u043b\u044f \u043f\u0440\u0430\u0432\u043e\u0433\u043e \u043d\u0438\u0436\u043d\u044c\u043e\u0433\u043e \u043a\u0443\u0442\u0430 \u043a\u0430\u0440\u0442\u0438. \u041f\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u0430 \u043f\u043e\u0437\u0438\u0446\u0456\u0454\u044e (\u0432\u0435\u0434\u0435\u043d\u043d\u044f, \u0430\u0431\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0431\u0435\u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443) \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u043d\u0430 \u043f\u0456\u0432 \u0440\u0456\u0432\u043d\u044f \u0439 \u0432\u0438\u043c\u0438\u043a\u0430\u044e\u0442\u044c \u00abAuto\u00bb; \u043f\u043e\u0437\u0430 \u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0431\u043b\u0438\u0436\u0430\u044e\u0442\u044c \u0456 \u0432\u0456\u0434\u0434\u0430\u043b\u044f\u044e\u0442\u044c \u043a\u0430\u0440\u0442\u0443."

