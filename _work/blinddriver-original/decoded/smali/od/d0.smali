    const-string v12, "\u0417\u043d\u0430\u0447\u043a\u0438 \u043a\u0430\u043c\u0435\u0440 \u0456\u0437 \u0447\u0438\u0441\u043b\u043e\u043c \u043b\u0456\u043c\u0456\u0442\u0443. \u041a\u043e\u0436\u043d\u0430 \u043a\u0430\u043c\u0435\u0440\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u043d\u0430\u043f\u0440\u044f\u043c\u043e\u043a, \u0443 \u044f\u043a\u043e\u043c\u0443 \u0434\u0456\u0454. \u0412\u0438\u0434\u043d\u043e \u0437 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443 11."

