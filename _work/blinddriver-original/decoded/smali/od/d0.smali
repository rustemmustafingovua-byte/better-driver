    const-string v1, "\u041e\u0431\u0440\u0430\u0442\u0438, \u0437\u0432\u0456\u0434\u043a\u0438 \u043f\u0435\u0440\u0435\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438: \u0437\u0430 \u043f\u043e\u0437\u0438\u0446\u0456\u0454\u044e \u0432\u0456\u0434 \u043c\u0435\u0440\u0435\u0436\u0456 (\u00b1100 \u043c, \u043a\u043e\u043b\u0438 GPS \u043d\u0435\u043c\u0430\u0454), \u0437\u0430 \u043f\u043e\u0437\u0438\u0446\u0456\u0454\u044e \u043d\u0430 \u043a\u0430\u0440\u0442\u0456 \u0430\u0431\u043e \u0437 \u0442\u043e\u0447\u043a\u0438, \u044f\u043a\u0443 \u0432\u0438 \u0432\u043a\u0430\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u0442\u044f\u043c. \u0422\u0443\u0442 \u0436\u0435 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u00ab\u0410\u0432\u0442\u043e-\u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430 \u043f\u0440\u0438 \u043d\u0430\u0434\u0456\u0439\u043d\u043e\u043c\u0443 GPS\u00bb (\u043d\u0435 \u0447\u0430\u0441\u0442\u0456\u0448\u0435 \u043d\u0456\u0436 \u0440\u0430\u0437 \u043d\u0430 20 \u0441); \u0431\u0435\u0437 GPS \u0434\u0456\u0454 \u043e\u043a\u0440\u0435\u043c\u0438\u0439 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u00ab\u0410\u0432\u0442\u043e-\u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430 \u0431\u0435\u0437 GPS\u00bb \u0443 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445. \u041d\u043e\u0432\u0438\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0431\u0443\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u0432 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443, \u043a\u0443\u0434\u0438 \u0432\u0438 \u0457\u0434\u0435\u0442\u0435, \u0456 \u043d\u0435 \u043f\u043e\u0447\u0438\u043d\u0430\u0454\u0442\u044c\u0441\u044f \u0440\u043e\u0437\u0432\u043e\u0440\u043e\u0442\u043e\u043c, \u044f\u043a\u0449\u043e \u0454 \u0434\u043e\u0440\u043e\u0433\u0430 \u0432\u043f\u0435\u0440\u0435\u0434. \u042f\u043a\u0449\u043e \u0440\u043e\u0443\u0442\u0435\u0440 \u0434\u0430\u0432 \u043a\u0456\u043b\u044c\u043a\u0430 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432, \u043e\u0431\u0435\u0440\u0456\u0442\u044c \u00ab\u0407\u0445\u0430\u0442\u0438 \u0446\u0438\u043c\u00bb \u0430\u0431\u043e \u00ab\u041b\u0438\u0448\u0438\u0442\u0438 \u0441\u0442\u0430\u0440\u0438\u0439\u00bb."

    invoke-direct {v0, v14, v15, v1}, Lod/j0;-><init>(Lod/i0;Ljava/lang/String;Ljava/lang/String;)V

