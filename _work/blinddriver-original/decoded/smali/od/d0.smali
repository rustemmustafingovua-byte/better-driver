    const-string v15, "\u0410\u0432\u0442\u043e\u0437\u0430\u043f\u0438\u0441 \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0443 (\u0443 \u0432\u0438\u043f\u0443\u0449\u0435\u043d\u0456\u0439 \u0432\u0435\u0440\u0441\u0456\u0457 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c), \u0440\u043e\u0437\u043c\u0456\u0440 \u043e\u0434\u043d\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0430 \u043b\u043e\u0433\u0443 \u0439 \u00ab\u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u043b\u043e\u0433\u0438 \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456\u00bb: \u043b\u043e\u0433\u0438, \u0441\u0442\u0430\u0440\u0448\u0456 \u0437\u0430 \u0432\u043a\u0430\u0437\u0430\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0434\u043d\u0456\u0432, \u0432\u0438\u0434\u0430\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0441\u0430\u043c\u0456 \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0443 (0 \u2014 \u043d\u0435 \u0432\u0438\u0434\u0430\u043b\u044f\u0442\u0438). \u0412\u0440\u0443\u0447\u043d\u0443 \u2014 \u00ab\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043b\u043e\u0433 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0443\u00bb \u2192 \u00ab\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0441\u0442\u0430\u0440\u0456 \u043b\u043e\u0433\u0438 \u0437 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430\u2026\u00bb. \u0417\u0430\u043f\u0438\u0441 \u0432\u043c\u0438\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u043a\u043d\u043e\u043f\u043a\u043e\u044e REC."

