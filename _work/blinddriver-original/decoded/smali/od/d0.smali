    const-string v12, "\u041b\u0435\u0436\u0430\u0447\u0456 \u043f\u043e\u043b\u0456\u0446\u0435\u0439\u0441\u044c\u043a\u0456"

    const-string v13, "\u0416\u043e\u0432\u0442\u0438\u0439 \u0437\u043d\u0430\u0447\u043e\u043a \u0456\u0437 \u00ab\u0433\u043e\u0440\u0431\u043e\u043c\u00bb \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0456, \u0437 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443 14 (\u0431\u0430\u0437\u0430 \u0437 OpenStreetMap, \u043f\u0440\u0430\u0446\u044e\u0454 \u0431\u0435\u0437 \u043c\u0435\u0440\u0435\u0436\u0456). \u0420\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043e\u043a \u0431\u0435\u0437 GPS \u043f\u043b\u0430\u0432\u043d\u043e \u0441\u043f\u043e\u0432\u0456\u043b\u044c\u043d\u044e\u0454 \u043c\u0430\u0440\u043a\u0435\u0440 \u043f\u0435\u0440\u0435\u0434 \u043d\u0438\u043c\u0438."

