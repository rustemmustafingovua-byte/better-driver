    const-string v9, "\u0410\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430 \u043f\u043e\u0457\u0437\u0434\u043e\u043a"

    const-string v10, "\u041f\u0440\u043e\u0431\u0456\u0433, \u0447\u0430\u0441 \u0443 \u0434\u043e\u0440\u043e\u0437\u0456 \u0439 \u043d\u0430 \u0441\u0442\u043e\u044f\u043d\u043a\u0430\u0445 \u0437\u0430 \u0434\u0435\u043d\u044c, \u0442\u0438\u0436\u0434\u0435\u043d\u044c \u0456 \u043c\u0456\u0441\u044f\u0446\u044c; \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0439 \u043a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442 \u0437\u0430\u0442\u043e\u0440\u0456\u0432, \u044f\u043a\u0438\u0439 \u0443\u0442\u043e\u0447\u043d\u044e\u0454 \u0447\u0430\u0441 \u043f\u0440\u0438\u0431\u0443\u0442\u0442\u044f \u0443 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0430\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443."

