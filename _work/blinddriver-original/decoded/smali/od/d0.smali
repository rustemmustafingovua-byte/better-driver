    const-string v2, "\u041c\u0430\u0440\u0448\u0440\u0443\u0442\u0438 \u0437\u0430 \u0433\u0440\u0430\u0444\u043e\u043c \u0434\u043e\u0440\u0456\u0433 \u0456 \u043f\u043e\u0448\u0443\u043a \u0430\u0434\u0440\u0435\u0441 \u0437\u0430 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u043e\u043c \u0431\u0435\u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c \u0443 \u043f\u0440\u043e\u0431\u043d\u043e\u043c\u0443 \u043f\u0435\u0440\u0456\u043e\u0434\u0456 \u0439 \u0437 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u043e\u044e. \u0411\u0435\u0437 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0438 \u043f\u0456\u0441\u043b\u044f \u043f\u0440\u043e\u0431\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0456\u043e\u0434\u0443 \u0432\u043e\u043d\u0438 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0456 (\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0456 \u0434\u0430\u043d\u0456 \u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456 \u0439 \u0437\u043d\u043e\u0432\u0443 \u0437\u0430\u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c \u0437 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u043e\u044e). \u041e\u0444\u043b\u0430\u0439\u043d-\u043a\u0430\u0440\u0442\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0432\u0441\u0456\u043c."

