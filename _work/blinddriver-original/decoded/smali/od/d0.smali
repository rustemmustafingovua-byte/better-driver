    const-string v2, "\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0438"

    const-string v3, "\u0423 \u043f\u043e\u0440\u043e\u0436\u043d\u044c\u043e\u043c\u0443 \u0440\u044f\u0434\u043a\u0443: \u0431\u0435\u0440\u0435 \u0437 \u0431\u0443\u0444\u0435\u0440\u0430 \u043e\u0431\u043c\u0456\u043d\u0443 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0438 \u0432\u0438\u0434\u0443 \u00ab50.45012 30.5234\u00bb (\u0442\u0430\u043a \u0457\u0445 \u043a\u043e\u043f\u0456\u044e\u0454 Uklon Driver \u0434\u043e\u0432\u0433\u0438\u043c \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f\u043c \u043d\u0430 \u0430\u0434\u0440\u0435\u0441\u0443) \u0456 \u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u0443 \u0442\u043e\u0447\u043a\u0443."

    invoke-direct {v5, v1, v2, v3}, Lod/j0;-><init>(Lod/i0;Ljava/lang/String;Ljava/lang/String;)V

