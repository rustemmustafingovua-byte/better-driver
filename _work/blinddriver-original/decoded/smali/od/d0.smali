    const-string v11, "\u041f\u043e\u0437\u0438\u0446\u0456\u044f \u0432\u0456\u0434 Wi-Fi \u0456 \u0432\u0438\u0448\u043e\u043a \u043e\u0431\u043c\u0435\u0436\u0443\u0454 \u043f\u043e\u0445\u0438\u0431\u043a\u0443 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u0443. \u0413\u0440\u0443\u0431\u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 (\u043f\u043e\u0445\u0438\u0431\u043a\u0430 300 \u043c \u0456 \u0431\u0456\u043b\u044c\u0448\u0435) \u043c\u0430\u0440\u043a\u0435\u0440 \u043d\u0435 \u0437\u0441\u0443\u0432\u0430\u044e\u0442\u044c. \u042f\u043a\u0449\u043e \u043a\u0456\u043b\u044c\u043a\u0430 \u0442\u043e\u0447\u043d\u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0456\u0439 \u0437\u0430 \u043c\u0435\u0440\u0435\u0436\u0435\u044e \u043f\u043e\u043a\u0430\u0437\u0443\u044e\u0442\u044c, \u0449\u043e \u0432\u0438 \u043f\u043e\u0437\u0430\u0434\u0443, \u043c\u0430\u0440\u043a\u0435\u0440 \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0437\u0430\u0434 (\u043d\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0456\u0436 \u043d\u0430 300 \u043c \u0437\u0430 \u0440\u0430\u0437 \u0456 \u043d\u0435 \u0437\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442, \u044f\u043a\u0438\u0439 \u0443\u0436\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0432 \u0433\u0456\u0440\u043e\u0441\u043a\u043e\u043f). \u041a\u043e\u043b\u0438 GPS \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f, \u043c\u0430\u0440\u043a\u0435\u0440 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u0437 \u043d\u0438\u043c \u043f\u043b\u0430\u0432\u043d\u043e."

