    const-string v5, "\u041b\u043e\u0433"

    const-string v7, "\u041a\u043d\u043e\u043f\u043a\u0430 \u043f\u0456\u0434 \u0440\u044f\u0434\u043a\u043e\u043c \u0430\u0434\u0440\u0435\u0441\u0438, \u043f\u0440\u0430\u0432\u043e\u0440\u0443\u0447 \u0432\u0456\u0434 REC. \u041d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0444\u0430\u0439\u043b \u043b\u043e\u0433\u0443 (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 Telegram \u0430\u0431\u043e \u043d\u0430 \u043f\u043e\u0448\u0442\u0443). \u0423 \u043b\u043e\u0433\u0443 \u0442\u0440\u0435\u043a\u0438, \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0439 \u043f\u043e\u0434\u0456\u0457 \u0434\u043b\u044f \u0440\u043e\u0437\u0431\u043e\u0440\u0443 \u0440\u043e\u0431\u043e\u0442\u0438 \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0457."

