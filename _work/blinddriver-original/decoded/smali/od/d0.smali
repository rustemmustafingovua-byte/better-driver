    const-string v12, "\u042f\u043a\u0449\u043e \u0431\u0430\u0447\u0438\u0442\u0435, \u0449\u043e \u043c\u0430\u0440\u043a\u0435\u0440 \u0432\u0438\u043f\u0435\u0440\u0435\u0434\u0436\u0430\u0454 \u0430\u0431\u043e \u0432\u0456\u0434\u0441\u0442\u0430\u0454, \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0439\u0442\u0435\u0441\u044f \u00ab\u2191100\u00bb \u0456 \u00ab\u2193100\u00bb."

