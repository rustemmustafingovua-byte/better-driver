    const-string v7, "\u041a\u043d\u043e\u043f\u043a\u0430 \u0437 \u043f\u0440\u0438\u0446\u0456\u043b\u043e\u043c \u043f\u043e\u0440\u0443\u0447 \u0456\u0437 \u00ab\u0420\u0443\u0448\u0430\u0439\u00bb: \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 \u043a\u0430\u043c\u0435\u0440\u0443 \u0434\u043e \u0432\u0430\u0448\u043e\u0457 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u043f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e, \u044f\u043a \u0432\u0438 \u043f\u0435\u0440\u0435\u0441\u0443\u043d\u0443\u043b\u0438 \u043a\u0430\u0440\u0442\u0443."

