    const-string v10, "\u0413\u0435\u043e\u043b\u043e\u043a\u0430\u0446\u0456\u044e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e"

    const-string v11, "\u0427\u0435\u0440\u0432\u043e\u043d\u0430 \u0441\u043c\u0443\u0433\u0430 \u0437\u0432\u0435\u0440\u0445\u0443: \u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0430 \u0433\u0435\u043e\u043b\u043e\u043a\u0430\u0446\u0456\u044f, \u0442\u043e\u0436 \u043d\u0435\u043c\u0430\u0454 \u043d\u0456 GPS, \u043d\u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0437\u0430 \u043c\u0435\u0440\u0435\u0436\u0435\u044e. \u041d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0457\u0457 \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438."

