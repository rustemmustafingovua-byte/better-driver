    const-string v6, "\u041f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 \u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u0430 \u0432\u0430\u0448\u043e\u044e \u043f\u043e\u0437\u0438\u0446\u0456\u0454\u044e \u043f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e, \u044f\u043a \u0432\u0438 \u043f\u0435\u0440\u0435\u0441\u0443\u043d\u0443\u043b\u0438 \u0430\u0431\u043e \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u043b\u0438 \u043a\u0430\u0440\u0442\u0443."

