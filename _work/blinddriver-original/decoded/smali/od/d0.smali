    const-string v9, "\u041f\u0430\u043d\u0435\u043b\u044c \u043c\u0430\u043d\u0435\u0432\u0440\u0443"

    const-string v10, "\u0421\u0438\u043d\u044f \u043f\u0430\u043d\u0435\u043b\u044c \u0437\u0432\u0435\u0440\u0445\u0443: \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u044c \u0434\u043e \u043c\u0430\u043d\u0435\u0432\u0440\u0443, \u0441\u0442\u0440\u0456\u043b\u043a\u0430, \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u044f \u0456 \u00ab\u041f\u043e\u0442\u0456\u043c\u2026\u00bb (\u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043c\u0430\u043d\u0435\u0432\u0440)."

