    const-string v15, "\u0422\u0430\u043a \u0441\u0430\u043c\u043e, \u044f\u043a \u0437\u0432\u0435\u0440\u0445\u0443: \u0447\u0435\u0440\u0432\u043e\u043d\u0438\u0439 \u0437 \u043a\u0440\u0430\u043f\u043a\u043e\u044e \u2014 \u0437\u0430\u043f\u0438\u0441 \u043b\u043e\u0433\u0443 \u0439\u0434\u0435. \u041d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u0432\u043c\u0438\u043a\u0430\u0454 \u0430\u0431\u043e \u0432\u0438\u043c\u0438\u043a\u0430\u0454 \u0437\u0430\u043f\u0438\u0441."

