    const-string v5, "\u0412\u0435\u0434\u0435\u043d\u043d\u044f \u0439 \u043a\u0430\u043c\u0435\u0440\u0438"

    const-string v13, "\u0410\u0432\u0442\u043e-\u043f\u0435\u0440\u0435\u0431\u0443\u0434\u043e\u0432\u0430 \u0437 GPS \u0456 \u0431\u0435\u0437 GPS, \u0441\u043f\u043e\u0432\u0456\u043b\u044c\u043d\u0435\u043d\u043d\u044f \u0431\u0456\u043b\u044f \u0441\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0456\u0432 \u0456 \u043b\u0435\u0436\u0430\u0447\u0438\u0445, \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0456 \u043f\u043e\u0432\u0435\u0434\u0456\u043d\u043a\u0438 \u0431\u0435\u0437 GPS (\u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u0445\u043e\u0434\u0443, \u0443\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u043c, \u00ab\u043f\u0440\u043e\u0457\u0445\u0430\u043b\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u00bb), \u043f\u043e\u0440\u043e\u0433\u0438 \u0441\u0445\u043e\u0434\u0443 \u0437 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 (\u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u0439 \u0456 \u0448\u0432\u0438\u0434\u043a\u0438\u0439), \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u044c \u00ab\u0412\u0438 \u043f\u0440\u0438\u0431\u0443\u043b\u0438\u00bb, \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0456\u0457 \u043a\u0430\u043c\u0435\u0440 \u0456 \u0434\u043e\u043f\u0443\u0441\u043a \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043d\u044f."

