    const-string v12, "\u0417\u043d\u0430\u0447\u043e\u043a \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0456 (\u0434\u0430\u043d\u0456 Mapbox), \u0437 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443 13,5. \u0411\u0435\u0437 GPS \u0443 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0441\u0442\u043e\u044f\u043d\u043d\u044f \u0431\u0456\u043b\u044f \u0441\u0432\u0456\u0442\u043b\u043e\u0444\u043e\u0440\u0430."

